---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Rating from '../components/Rating.astro';
import AuthorBio from '../components/AuthorBio.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { slugifyCategory } from '../utils/slug';
import { unsplashSrc } from '../utils/image';
import { getAuthorByName } from '../data/authors';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  image?: string;
  imageAlt?: string;
  rating?: number;
  reviewedName?: string;
  pros?: string[];
  cons?: string[];
  tags?: string[];
  author?: string;
  headings?: MarkdownHeading[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  image,
  imageAlt,
  rating,
  reviewedName,
  pros,
  cons,
  tags = [],
  author = 'Sonar Musical',
  headings = [],
} = Astro.props;

// Só monta o índice quando há estrutura suficiente pra justificá-lo.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length >= 3;

const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updatedDate?.toLocaleDateString('pt-BR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const absoluteImage = image
  ? (/^https?:\/\//.test(image) ? image : `https://sonarmusical.com.br${image}`)
  : undefined;

const canonicalPostUrl = new URL(Astro.url.pathname, Astro.site).href;

const authorRecord = getAuthorByName(author);
const authorSchema = authorRecord
  ? {
      '@type': 'Person',
      name: authorRecord.name,
      url: `https://sonarmusical.com.br/autor/${authorRecord.slug}/`,
      image: `https://sonarmusical.com.br${authorRecord.photo}`,
      ...(authorRecord.sameAs.length > 0 && { sameAs: authorRecord.sameAs }),
    }
  : { '@type': 'Organization', name: author };

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'pt-BR',
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalPostUrl },
  author: authorSchema,
  datePublished: pubDate.toISOString(),
  // O Google usa dateModified para decidir o quão atual é o conteúdo. Sem o campo
  // ele assume a data de publicação; explicitar o fallback deixa o sinal consistente.
  dateModified: (updatedDate ?? pubDate).toISOString(),
  publisher: {
    '@type': 'Organization',
    name: 'Sonar Musical',
    url: 'https://sonarmusical.com.br',
    logo: {
      '@type': 'ImageObject',
      url: 'https://sonarmusical.com.br/favicon.svg',
    },
  },
  ...(absoluteImage && { image: absoluteImage }),
};

// Post de review de produto único (tem rating): emite um nó Product SEPARADO com o
// review aninhado. O Google exige que todo Product tenha offers, review ou
// aggregateRating — aninhar o review aqui satisfaz isso e valida o snippet de produto.
// (Antes era um Review com itemReviewed: Product "vazio", que o GSC reprovava com
// "Especifique offers, review ou aggregateRating".) reviewedName dá o nome limpo do
// produto, sem o "Vale a Pena?/Review" do título do post.
const productSchema = rating
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: reviewedName ?? title,
      ...(absoluteImage && { image: absoluteImage }),
      review: {
        '@type': 'Review',
        reviewRating: {
          '@type': 'Rating',
          ratingValue: rating,
          bestRating: 5,
          worstRating: 1,
        },
        author: authorSchema,
        datePublished: pubDate.toISOString(),
      },
    }
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://sonarmusical.com.br/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://sonarmusical.com.br/blog/' },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalPostUrl },
  ],
};

const pageSchema = [articleSchema, ...(productSchema ? [productSchema] : []), breadcrumbSchema];

const categoryColors: Record<string, string> = {
  Guitarras: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
  Amplificadores: 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300',
  Pedais: 'bg-green-100 text-green-700 dark:bg-green-900/40 dark:text-green-300',
  Acessórios: 'bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300',
  'Guias de Compra': 'bg-brand/20 text-brand',
  'Dicas para Iniciantes': 'bg-teal-100 text-teal-700 dark:bg-teal-900/40 dark:text-teal-300',
};
const badgeClass = categoryColors[category] ?? 'bg-elevated text-muted';
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type="article"
  pubDate={pubDate}
  author={author}
  schema={pageSchema}
>
  <ReadingProgress />

  <div class="mx-auto max-w-6xl px-4 py-16 xl:flex xl:gap-10 xl:justify-center">
  <article class="w-full max-w-3xl min-w-0" data-pagefind-body>
    <!-- Breadcrumb -->
    <nav aria-label="Navegação em breadcrumb" class="mb-8 flex items-center gap-2 text-sm text-muted">
      <a href="/" class="hover:text-foreground transition-colors">Início</a>
      <span aria-hidden="true">/</span>
      <a href="/blog/" class="hover:text-foreground transition-colors">Blog</a>
      <span aria-hidden="true">/</span>
      <span class="text-foreground" aria-current="page">{title}</span>
    </nav>

    <!-- Categoria + Avaliação -->
    <div class="flex items-center gap-3 mb-4">
      <a
        href={`/categoria/${slugifyCategory(category)}/`}
        class={`text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full ${badgeClass}`}
      >
        {category}
      </a>
      {rating && <Rating value={rating} />}
    </div>

    <!-- Título -->
    <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight leading-[1.1] mb-4">{title}</h1>

    <!-- Metadados -->
    <div class="flex flex-wrap items-center gap-4 text-sm text-muted mb-8 pb-8 border-b border-border">
      {authorRecord ? (
        <AuthorBio author={authorRecord} />
      ) : (
        <span>Por <strong class="text-foreground">{author}</strong></span>
      )}
      <time datetime={pubDate.toISOString()}>
        {formattedDate}
      </time>
      {updatedDate && (
        <span>
          Atualizado em: <time datetime={updatedDate.toISOString()}>{formattedUpdated}</time>
        </span>
      )}
    </div>

    <!-- Imagem de capa -->
    {image && (
      <figure class="mb-10 rounded-2xl overflow-hidden border border-border shadow-xl shadow-black/20">
        <img
          src={unsplashSrc(image, 900)}
          srcset={`${unsplashSrc(image, 900)} 1x, ${unsplashSrc(image, 1600)} 2x`}
          alt={imageAlt ?? title}
          width="768"
          height="432"
          class="w-full object-cover aspect-video bg-card"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </figure>
    )}

    <!-- Índice colapsável (mobile/tablet) -->
    {hasToc && (
      <details class="xl:hidden mb-10 rounded-xl border border-border bg-card px-5 py-4" open data-pagefind-ignore>
        <summary class="toc-summary cursor-pointer list-none flex items-center justify-between gap-4 text-sm font-semibold marker:content-none">
          <span>Neste artigo</span>
          <svg class="shrink-0 transition-transform duration-200" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </summary>
        <div class="mt-4">
          <TableOfContents headings={headings} hideTitle />
        </div>
      </details>
    )}

    <!-- Prós / Contras -->
    {(pros?.length || cons?.length) && (
      <div class="grid sm:grid-cols-2 gap-4 mb-10 p-6 bg-elevated rounded-xl border border-border">
        {pros?.length && (
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-green-400 mb-3">Prós</h2>
            <ul class="space-y-2">
              {pros.map((p) => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="text-green-400 mt-0.5" aria-hidden="true">✓</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        {cons?.length && (
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-red-400 mb-3">Contras</h2>
            <ul class="space-y-2">
              {cons.map((c) => (
                <li class="flex items-start gap-2 text-sm">
                  <span class="text-red-400 mt-0.5" aria-hidden="true">✗</span>
                  <span>{c}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    <!-- Conteúdo do post -->
    <div class="prose-post">
      <slot />
    </div>

    <!-- Tags -->
    {tags.length > 0 && (
      <footer class="mt-12 pt-8 border-t border-border">
        <p class="text-sm text-muted mb-3">Tags:</p>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="text-xs bg-card border border-border px-3 py-1 rounded-full text-muted">
              #{tag}
            </span>
          ))}
        </div>
      </footer>
    )}
  </article>

  <!-- Índice fixo (desktop) -->
  {hasToc && (
    <aside class="hidden xl:block w-56 shrink-0">
      <div class="sticky top-24">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  )}
  </div>

  <style>
    .prose-post :global(h2) {
      position: relative;
      font-size: 1.6rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-top: 2.75rem;
      margin-bottom: 1rem;
      padding-left: 0.9rem;
      color: var(--color-foreground);
    }
    .prose-post :global(h2)::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.16em;
      bottom: 0.16em;
      width: 4px;
      border-radius: 3px;
      background: linear-gradient(var(--color-brand), var(--color-brand-dark));
    }
    .prose-post :global(p:first-of-type) {
      font-size: 1.15rem;
      line-height: 1.7;
      color: var(--color-foreground);
    }
    .prose-post :global(h3) {
      font-size: 1.2rem;
      font-weight: 600;
      margin-top: 2rem;
      margin-bottom: 0.75rem;
      color: var(--color-foreground);
    }
    .prose-post :global(p) {
      line-height: 1.8;
      margin-bottom: 1.25rem;
      color: var(--color-muted);
    }
    .prose-post :global(ul),
    .prose-post :global(ol) {
      margin-bottom: 1.25rem;
      padding-left: 1.5rem;
      color: var(--color-muted);
    }
    .prose-post :global(li) {
      margin-bottom: 0.55rem;
      line-height: 1.7;
    }
    .prose-post :global(ul) {
      list-style: none;
    }
    .prose-post :global(ul li) {
      position: relative;
    }
    .prose-post :global(ul li)::before {
      content: '';
      position: absolute;
      left: -1.1rem;
      top: 0.62em;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--color-brand);
    }
    .prose-post :global(ol li) {
      list-style-type: decimal;
    }
    .prose-post :global(ol li)::marker {
      color: var(--color-brand);
      font-weight: 700;
    }
    .prose-post :global(strong) {
      color: var(--color-foreground);
      font-weight: 600;
    }
    .prose-post :global(a:not(.afiliado-cta__btn)) {
      color: #e63946;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .prose-post :global(a:not(.afiliado-cta__btn):hover) {
      color: #ff5b67;
    }
    .prose-post :global(blockquote) {
      border-left: 4px solid var(--color-brand);
      background: color-mix(in srgb, var(--color-brand) 6%, var(--color-elevated));
      padding: 1rem 1.25rem;
      border-radius: 0 12px 12px 0;
      margin: 1.75rem 0;
      color: var(--color-foreground);
    }
    .prose-post :global(blockquote p:last-child) {
      margin-bottom: 0;
    }
    .prose-post :global(code) {
      background: var(--color-elevated);
      padding: 0.15em 0.4em;
      border-radius: 4px;
      font-size: 0.875em;
      color: #e63946;
    }
    /* Tabelas markdown: rolam na horizontal dentro do próprio bloco em telas
       estreitas, em vez de estourar o layout da página. As tabelas comparativas
       de produto usam o componente <ComparativoProdutos> (vira cards no mobile). */
    .prose-post :global(table:not([class])) {
      display: block;
      width: 100%;
      max-width: 100%;
      overflow-x: auto;
      border-collapse: collapse;
      margin: 1.75rem 0;
      font-size: 0.95rem;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      -webkit-overflow-scrolling: touch;
    }
    .prose-post :global(th) {
      background: color-mix(in srgb, var(--color-brand) 9%, var(--color-elevated));
      padding: 0.75rem 1rem;
      text-align: left;
      font-weight: 700;
      color: var(--color-foreground);
      border-bottom: 1px solid var(--color-border);
    }
    .prose-post :global(td) {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-muted);
    }
    .prose-post :global(tr:hover td) {
      background: var(--color-elevated);
    }
    .prose-post :global(hr) {
      border: none;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--color-border) 15%, var(--color-brand) 50%, var(--color-border) 85%, transparent);
      opacity: 0.65;
      margin: 2.75rem 0;
    }
    /* Compensa o header fixo (h-16) ao pular para uma âncora do índice */
    .prose-post :global(h2),
    .prose-post :global(h3) {
      scroll-margin-top: 6rem;
    }
    /* Chevron do índice colapsável (mobile) */
    .toc-summary::-webkit-details-marker {
      display: none;
    }
    details[open] > .toc-summary svg {
      transform: rotate(180deg);
    }
  </style>

  {hasToc && (
    <script>
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')
      );
      if (links.length && 'IntersectionObserver' in window) {
        const slugs = Array.from(new Set(links.map((l) => l.dataset.tocLink!)));
        const headingEls = slugs
          .map((id) => document.getElementById(id))
          .filter((el): el is HTMLElement => el !== null);

        const setActive = (slug: string) => {
          links.forEach((l) =>
            l.classList.toggle('is-active', l.dataset.tocLink === slug)
          );
        };

        const visible = new Set<string>();
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) visible.add(e.target.id);
              else visible.delete(e.target.id);
            });
            const active = headingEls.find((h) => visible.has(h.id));
            if (active) setActive(active.id);
          },
          { rootMargin: '-80px 0px -70% 0px' }
        );
        headingEls.forEach((h) => observer.observe(h));
      }
    </script>
  )}
</BaseLayout>
