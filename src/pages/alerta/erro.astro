---
// Erro no formulário sem JavaScript: /api/alerta manda para cá com ?c=<código>.
// Só códigos conhecidos viram texto (nada da URL é exibido), para ninguém montar um
// link do Sonar com mensagem inventada. Códigos em netlify/lib/alertas-core.mjs.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Não deu para criar o alerta"
  description="Houve um problema ao criar seu alerta de preço."
  noindex
>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-4xl font-black mb-4">Não deu para criar o alerta</h1>
    <p class="text-muted text-lg mb-10" id="alerta-erro">Confira o e-mail e o valor digitado e tente de novo.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <button type="button" id="alerta-voltar" class="px-6 py-3 bg-brand-fill text-white font-semibold rounded-xl hover:bg-brand-dark transition-colors">Voltar e corrigir</button>
      <a href="/" class="px-6 py-3 border border-border font-semibold rounded-xl hover:border-brand transition-colors">Voltar ao início</a>
    </div>
  </div>
</BaseLayout>

<script>
  const textos: Record<string, string> = {
    email: 'Confira o e-mail: parece incompleto.',
    produto: 'Não encontramos este produto. Recarregue a ficha e tente de novo.',
    alvo: 'Digite o preço que você quer pagar, por exemplo 1.200.',
    'alvo-alto': 'O preço de hoje já está abaixo do valor que você digitou. Escolha um valor menor ou "qualquer queda".',
    'limite-ip': 'Muitos pedidos hoje a partir desta conexão. Tente amanhã.',
    'limite-email': 'Este e-mail já tem o máximo de alertas. Cancele algum pelo link dos e-mails antes de criar outro.',
    envio: 'Não conseguimos enviar o e-mail de confirmação agora. Tente de novo em alguns minutos.',
  };
  const c = new URLSearchParams(location.search).get('c') ?? '';
  const alvo = document.getElementById('alerta-erro');
  if (alvo && Object.hasOwn(textos, c)) alvo.textContent = textos[c];
  document.getElementById('alerta-voltar')?.addEventListener('click', () => history.back());
</script>
