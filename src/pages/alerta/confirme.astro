---
// Volta do formulário de alerta de preço sem JavaScript (POST /api/alerta).
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Confirme seu alerta de preço"
  description="Enviamos um e-mail para confirmar seu alerta de preço do Sonar Musical."
  noindex
>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <h1 class="text-4xl font-black mb-4">Falta um clique</h1>
    <p class="text-muted text-lg mb-4">
      Enviamos um e-mail com o assunto <strong class="text-foreground">"Confirme seu alerta de preço"</strong>. Toque em <strong class="text-foreground">Confirmar alerta</strong> para ativar.
    </p>
    <p class="text-muted mb-10">
      Não chegou em alguns minutos? Olhe a caixa de spam ou a aba Promoções do Gmail. O link vale por 7 dias.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/black-friday/" class="px-6 py-3 bg-brand-fill text-white font-semibold rounded-xl hover:bg-brand-dark transition-colors">Ver as ofertas</a>
      <a href="/" class="px-6 py-3 border border-border font-semibold rounded-xl hover:border-brand transition-colors">Voltar ao início</a>
    </div>
  </div>
</BaseLayout>
