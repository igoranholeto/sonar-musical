---
import BaseLayout from '../layouts/BaseLayout.astro';
// Os arquivos /pagefind/* são gerados no build (astro build && pagefind --site dist).
// Em `astro dev` eles não existem — rode `npm run build && npm run preview` para testar.
---

<BaseLayout
  title="Buscar no Sonar Musical"
  description="Encontre análises, guias de compra e reviews de equipamentos musicais no Sonar Musical."
>
  <section class="max-w-2xl mx-auto px-4 py-16 min-h-[60vh]">
    <h1 class="text-3xl sm:text-4xl font-bold mb-2">Buscar</h1>
    <p class="text-muted mb-8">Procure por análises, guias e reviews de equipamento musical.</p>

    <div id="busca"></div>

    <noscript>
      <p class="text-muted">A busca precisa de JavaScript ativado.</p>
    </noscript>
  </section>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (typeof PagefindUI === 'undefined') return;
      var ui = new PagefindUI({
        element: '#busca',
        showSubResults: true,
        showImages: false,
        pageSize: 8,
        translations: {
          placeholder: 'Buscar equipamentos, bandas, guias...',
          clear_search: 'Limpar',
          load_more: 'Ver mais resultados',
          search_label: 'Buscar no site',
          zero_results: 'Nenhum resultado para "[SEARCH_TERM]"',
          many_results: '[COUNT] resultados para "[SEARCH_TERM]"',
          one_result: '[COUNT] resultado para "[SEARCH_TERM]"',
        },
      });

      // Pré-preenche a busca a partir de ?q= (compatível com o SearchAction do schema)
      var q = new URLSearchParams(window.location.search).get('q');
      if (q) {
        var input = document.querySelector('#busca .pagefind-ui__search-input');
        if (input) {
          input.value = q;
          input.dispatchEvent(new Event('input', { bubbles: true }));
        }
      }
    });
  </script>

  <style is:global>
    /* Alinha o Pagefind UI ao tema do site (marca, superfícies, bordas) */
    #busca {
      --pagefind-ui-primary: var(--color-brand);
      --pagefind-ui-text: var(--color-foreground);
      --pagefind-ui-background: var(--color-card);
      --pagefind-ui-border: var(--color-border);
      --pagefind-ui-tag: var(--color-elevated);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 12px;
      --pagefind-ui-font: var(--font-sans);
    }
  </style>
</BaseLayout>
