---
import BaseLayout from '../layouts/BaseLayout.astro';
// Produtos vêm de /busca-produtos.json (gerado no build); guias vêm do Pagefind
// (/pagefind/*, gerado depois do build). Em `astro dev` só os produtos aparecem:
// rode `npm run build && npm run preview` para testar tudo.
---

<BaseLayout
  title="Buscar no Sonar Musical"
  description="Encontre produtos com preço de hoje, análises, guias de compra e reviews de equipamentos musicais no Sonar Musical."
  noindex
>
  <section class="max-w-2xl mx-auto px-4 py-16 min-h-[60vh]">
    <h1 class="text-3xl sm:text-4xl font-bold mb-2">Buscar</h1>
    <p class="text-muted mb-8">Procure produtos (com o preço de hoje), análises, guias e reviews de equipamento musical.</p>

    <form id="busca-form" class="busca-pag__form" action="/busca/" method="get" role="search">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <label for="busca-input" class="sr-only">Buscar no site</label>
      <input id="busca-input" type="search" name="q" placeholder="Buscar produto, marca ou guia..." autocomplete="off" enterkeyhint="search" />
    </form>

    <p id="busca-status" class="busca-pag__status" aria-live="polite"></p>
    <div id="busca-produtos"></div>
    <div id="busca-guias"></div>
    <button id="busca-mais" type="button" class="busca-pag__mais" hidden>Ver mais guias</button>

    <noscript>
      <p class="text-muted">A busca precisa de JavaScript ativado.</p>
    </noscript>
  </section>

  <script>
    import { buscarProdutos, carregarPagefind, carregarProdutos, esc, htmlProdutos } from '../scripts/busca';

    const POR_PAGINA = 10;
    const form = document.getElementById('busca-form') as HTMLFormElement;
    const input = document.getElementById('busca-input') as HTMLInputElement;
    const status = document.getElementById('busca-status')!;
    const elProdutos = document.getElementById('busca-produtos')!;
    const elGuias = document.getElementById('busca-guias')!;
    const mais = document.getElementById('busca-mais') as HTMLButtonElement;

    let seq = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let pendentes: { data: () => Promise<any> }[] = [];

    const htmlGuia = (d: any) =>
      `<a class="busca-pag__guia" href="${esc(d.url)}"><span class="busca-pag__titulo">${esc(d.meta?.title ?? d.url)}</span><span class="busca-pag__trecho">${d.excerpt ?? ''}</span></a>`;

    const mostrarMais = async (minha: number) => {
      const lote = pendentes.splice(0, POR_PAGINA);
      const dados = await Promise.all(lote.map((r) => r.data()));
      if (minha !== seq) return;
      elGuias.insertAdjacentHTML('beforeend', dados.map(htmlGuia).join(''));
      mais.hidden = pendentes.length === 0;
    };

    const buscar = async () => {
      const q = input.value.trim();
      const minha = ++seq;
      const url = new URL(location.href);
      if (q) url.searchParams.set('q', q);
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);

      if (q.length < 2) {
        status.textContent = '';
        elProdutos.innerHTML = '';
        elGuias.innerHTML = '';
        mais.hidden = true;
        return;
      }

      const produtos = buscarProdutos(await carregarProdutos(), q, 200);
      if (minha !== seq) return;
      const LIMITE = 8;
      const renderProdutos = (todos: boolean) => {
        const lista = todos ? produtos : produtos.slice(0, LIMITE);
        const resto = produtos.length - lista.length;
        elProdutos.innerHTML = produtos.length
          ? `<h2 class="bp-sec">Produtos</h2>${htmlProdutos(lista)}${
              resto ? `<button type="button" class="busca-pag__mais" data-mais-produtos>Ver mais ${resto} ${resto === 1 ? 'produto' : 'produtos'}</button>` : ''
            }`
          : '';
        elProdutos.querySelector('[data-mais-produtos]')?.addEventListener('click', () => renderProdutos(true));
      };
      renderProdutos(false);

      const pf = await carregarPagefind();
      const r = pf ? await pf.search(q) : { results: [] };
      if (minha !== seq) return;
      pendentes = [...r.results];
      const nGuias = pendentes.length;
      elGuias.innerHTML = nGuias ? '<h2 class="bp-sec">Guias e análises</h2>' : '';
      await mostrarMais(minha);
      if (minha !== seq) return;

      const partes = [];
      if (produtos.length) partes.push(`${produtos.length} ${produtos.length === 1 ? 'produto' : 'produtos'}`);
      if (nGuias) partes.push(`${nGuias} ${nGuias === 1 ? 'guia' : 'guias'}`);
      status.textContent = partes.length ? `${partes.join(' e ')} para “${q}”` : `Nada encontrado para “${q}”. Tente outra palavra, como o nome de uma marca ou instrumento.`;
    };

    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(buscar, 150);
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearTimeout(timer);
      buscar();
    });
    mais.addEventListener('click', () => mostrarMais(seq));

    // Pré-preenche a partir de ?q= (link "Ver todos os resultados" do painel do menu).
    const q = new URLSearchParams(location.search).get('q');
    if (q) {
      input.value = q;
      buscar();
    } else {
      input.focus();
    }
    carregarProdutos();
    carregarPagefind();
  </script>

  <style is:global>
    .busca-pag__form {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0 1rem;
      height: 3.5rem;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--color-card);
      color: var(--color-muted);
    }
    .busca-pag__form:focus-within { border-color: var(--color-brand); }
    .busca-pag__form input {
      flex: 1;
      min-width: 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--color-foreground);
      font-size: 1.05rem;
    }
    .busca-pag__status { margin: 1rem 0 0.5rem; font-size: 0.875rem; color: var(--color-muted); min-height: 1.25rem; }
    #busca-produtos .bp-sec,
    #busca-guias .bp-sec { margin: 1.5rem 0 0.4rem; }
    #busca-produtos .bp-prod { padding-left: 0.4rem; padding-right: 0.4rem; }
    .busca-pag__guia {
      display: block;
      padding: 0.85rem 0.4rem;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-foreground);
      text-decoration: none;
    }
    .busca-pag__guia:hover .busca-pag__titulo { color: var(--color-brand); }
    .busca-pag__titulo { display: block; font-weight: 700; line-height: 1.35; }
    .busca-pag__trecho { display: block; margin-top: 0.25rem; font-size: 0.875rem; color: var(--color-muted); }
    .busca-pag__trecho mark { background: color-mix(in srgb, var(--color-brand) 22%, transparent); color: inherit; border-radius: 3px; padding: 0 2px; }
    .busca-pag__mais {
      display: block;
      margin: 1.25rem auto 0;
      padding: 0.6rem 1.2rem;
      border: 1px solid var(--color-border);
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--color-foreground);
    }
    .busca-pag__mais:hover { background: var(--color-elevated); }
    .busca-pag__mais[hidden] { display: none; }
  </style>
</BaseLayout>
