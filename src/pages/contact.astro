---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contato, Sonar Musical',
  url: 'https://sonarmusical.com.br/contact',
  inLanguage: 'pt-BR',
  mainEntity: {
    '@type': 'Organization',
    name: 'Sonar Musical',
    url: 'https://sonarmusical.com.br',
    email: 'oi@sonarmusical.com.br',
    sameAs: ['https://www.instagram.com/sonar_musical'],
    contactPoint: {
      '@type': 'ContactPoint',
      email: 'oi@sonarmusical.com.br',
      contactType: 'customer support',
      availableLanguage: 'Portuguese',
    },
  },
};
---

<BaseLayout
  title="Contato: Fale com o Sonar Musical"
  description="Tem uma dúvida, quer sugerir um produto para análise ou apenas quer falar com a gente? Entre em contato com o Sonar Musical."
  schema={contactSchema}
>
  <div class="max-w-2xl mx-auto px-4 py-16">
    <!-- Cabeçalho -->
    <div class="mb-12 text-center">
      <h1 class="text-4xl font-black mb-4">Entre em Contato</h1>
      <p class="text-muted text-lg">
        Tem uma pergunta, sugestão de análise ou só quer dizer oi? Lemos todas as mensagens.
      </p>
    </div>

    <!-- Formulário de contato -->
    <form
      class="space-y-5 mb-16"
      aria-label="Formulário de contato"
      action="#"
      method="post"
      novalidate
    >
      <div class="grid sm:grid-cols-2 gap-5">
        <div>
          <label for="name" class="block text-sm font-medium mb-2">Nome</label>
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            required
            placeholder="Seu nome"
            class="w-full px-4 py-3 bg-card border border-border rounded-xl text-foreground placeholder-subtle text-sm focus:outline-none focus:border-brand transition-colors"
          />
        </div>
        <div>
          <label for="contact-email" class="block text-sm font-medium mb-2">E-mail</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="seu@email.com"
            class="w-full px-4 py-3 bg-card border border-border rounded-xl text-foreground placeholder-subtle text-sm focus:outline-none focus:border-brand transition-colors"
          />
        </div>
      </div>

      <div>
        <label for="subject" class="block text-sm font-medium mb-2">Assunto</label>
        <select
          id="subject"
          name="subject"
          class="w-full px-4 py-3 bg-card border border-border rounded-xl text-foreground text-sm focus:outline-none focus:border-brand transition-colors appearance-none"
        >
          <option value="">Selecione um assunto…</option>
          <option value="review-request">Sugestão de análise</option>
          <option value="question">Dúvida geral</option>
          <option value="correction">Correção ou atualização</option>
          <option value="partnership">Parceria / colaboração</option>
          <option value="other">Outro</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium mb-2">Mensagem</label>
        <textarea
          id="message"
          name="message"
          required
          rows="5"
          placeholder="O que você quer nos dizer?"
          class="w-full px-4 py-3 bg-card border border-border rounded-xl text-foreground placeholder-subtle text-sm focus:outline-none focus:border-brand transition-colors resize-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full py-3.5 bg-brand text-white font-semibold rounded-xl hover:bg-brand-dark transition-colors shadow-lg shadow-brand/25"
      >
        Enviar Mensagem
      </button>
    </form>

    <!-- Contato direto -->
    <div class="mb-12 p-8 bg-elevated border border-border rounded-2xl text-center">
      <p class="text-sm text-muted mb-4">Prefere falar direto? Escreva pra gente:</p>
      <a
        href="mailto:oi@sonarmusical.com.br"
        class="inline-flex items-center gap-2 text-lg font-semibold text-brand hover:text-brand-dark transition-colors"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        oi@sonarmusical.com.br
      </a>
      <div class="mt-6 pt-6 border-t border-border">
        <p class="text-sm text-muted mb-3">Ou acompanhe a gente no Instagram:</p>
        <a
          href="https://www.instagram.com/sonar_musical"
          rel="me noopener noreferrer"
          target="_blank"
          class="inline-flex items-center gap-2 font-semibold hover:text-brand transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
          </svg>
          @sonar_musical
        </a>
      </div>
    </div>

    <!-- Cards informativos -->
    <div class="grid sm:grid-cols-2 gap-4">
      <div class="p-6 bg-elevated border border-border rounded-xl">
        <h2 class="font-semibold mb-2">Sugestões de Análise</h2>
        <p class="text-sm text-muted">
          Tem um produto que gostaria que analisássemos? Nos conte a marca, modelo e onde encontrá-lo.
        </p>
      </div>
      <div class="p-6 bg-elevated border border-border rounded-xl">
        <h2 class="font-semibold mb-2">Tempo de Resposta</h2>
        <p class="text-sm text-muted">
          Geralmente respondemos em 2 a 3 dias úteis. Para assuntos urgentes, mencione no assunto da mensagem.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
