---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';

const faqItems = [
  {
    question: "O dicionário de acordes é grátis?",
    answer: "Sim. Escolha a tônica (C, D, E...) e o tipo de acorde (maior, menor, sétima...) e o diagrama de digitação aparece na hora, com o áudio do acorde. Tudo grátis, direto no navegador, sem instalar nada."
  },
  {
    question: "Como ler um diagrama de acorde de guitarra?",
    answer: "As seis linhas verticais são as cordas (da mais grave à esquerda para a mais aguda à direita) e as linhas horizontais são os trastes. As bolinhas mostram onde apertar. Um 'O' acima da corda significa tocá-la solta; um 'X' significa não tocar aquela corda. Quando o acorde não começa no primeiro traste, o número à esquerda indica em qual casa a figura está."
  },
  {
    question: "O que significa um acorde 'maior' ou 'menor'?",
    answer: "É o caráter do acorde. O acorde maior soa alegre e resolvido; o menor soa mais triste ou melancólico. A diferença está em uma única nota (a terça), mas ela muda completamente a emoção do som. A maioria das músicas combina os dois."
  },
  {
    question: "O que é um acorde com pestana (barre)?",
    answer: "É quando um dedo (geralmente o indicador) pressiona várias cordas ao mesmo tempo numa mesma casa, formando uma 'pestana'. Acordes com pestana permitem tocar qualquer tônica movendo a mesma forma pelo braço, mas exigem mais força, são o passo seguinte depois dos acordes abertos."
  },
  {
    question: "Qual a diferença entre os acordes abertos e os com pestana?",
    answer: "Acordes abertos usam cordas soltas e ficam nas primeiras casas, são os primeiros que todo iniciante aprende (C, G, D, Em, Am). Os acordes com pestana não usam cordas soltas e podem ser deslizados pelo braço para formar qualquer tom, o que os torna essenciais para tocar em qualquer tonalidade."
  },
  {
    question: "Preciso decorar todos os acordes?",
    answer: "Não. Com cerca de 8 acordes abertos (C, G, D, E, A, Em, Am, Dm) você já toca centenas de músicas. As formas com pestana vêm depois e, como são móveis, você aprende poucas formas e as aplica a todas as tônicas. Este dicionário serve justamente para consultar na hora que precisar."
  }
];

// Renderizados no servidor (evita layout shift / CLS ao aparecerem só via JS)
const NOTES_UI = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
const QUALITIES_UI = [
  { key: 'maj', label: 'Maior' },
  { key: 'm', label: 'Menor' },
  { key: '7', label: '7' },
  { key: 'm7', label: 'm7' },
  { key: 'maj7', label: 'Maj7' },
  { key: 'sus4', label: 'sus4' },
];
---

<BaseLayout
  title="Dicionário de Acordes de Guitarra e Violão — Grátis"
  description="Dicionário visual de acordes de guitarra e violão. Escolha a tônica e o tipo (maior, menor, 7, m7, sus4) e veja o diagrama de digitação. Grátis."
  schema={{
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Dicionário de Acordes, Sonar Musical',
    url: 'https://sonarmusical.com.br/acordes/',
    applicationCategory: 'EducationalApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
  }}
>
  <div class="chord-page">
    <header class="chord-header">
      <h1>Dicionário de Acordes</h1>
      <p class="chord-subtitle">Guitarra e violão · Diagrama + som · Grátis</p>
    </header>

    <div class="selector">
      <span class="selector-label">Tônica</span>
      <div id="root-row" class="root-grid">
        {NOTES_UI.map((n, i) => (
          <button type="button" class={`box${i === 0 ? ' box--active' : ''}`} data-root={i}>{n}</button>
        ))}
      </div>
    </div>

    <div class="selector">
      <span class="selector-label">Tipo de acorde</span>
      <div id="quality-row" class="quality-grid">
        {QUALITIES_UI.map((q, i) => (
          <button type="button" class={`box${i === 0 ? ' box--active' : ''}`} data-qual={q.key}>{q.label}</button>
        ))}
      </div>
    </div>

    <div class="chord-result">
      <div class="chord-top">
        <span class="chord-name" id="chord-name">C</span>
        <button id="play-chord" class="play-chord-btn" aria-label="Ouvir o acorde">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          Ouvir
        </button>
      </div>
      <div id="chord-diagram" class="chord-diagram"></div>
      <p id="chord-note" class="chord-note"></p>
    </div>

    <section class="chord-article">
      <h2>Como usar o dicionário de acordes</h2>
      <p>
        Escolha a <strong>tônica</strong> (a nota que dá nome ao acorde, como C ou G) e o <strong>tipo</strong> (maior, menor, com sétima…). O diagrama mostra exatamente onde colocar os dedos, e o botão de áudio toca o acorde com som de corda dedilhada para você conferir se está soando certo.
      </p>
      <p>
        Se você está começando, comece pelos acordes abertos mais comuns, <strong>C, G, D, E, A, Em, Am e Dm</strong>, que aparecem em milhares de músicas (temos um guia dos <a href="/blog/acordes-de-guitarra-para-iniciantes/">8 primeiros acordes para iniciantes</a> com a digitação de cada um). Só depois parta para as formas com pestana. E lembre: antes de tudo, deixe o instrumento afinado com o nosso <a href="/afinador/">afinador online</a>, porque um acorde certo numa guitarra desafinada continua soando errado.
      </p>
      <p>
        Para treinar a troca entre acordes no tempo, use o nosso <a href="/metronomo/">metrônomo online</a>. E para entender a lógica das notas de cada acorde, o <a href="/blog/nome-das-cordas-da-guitarra/">guia das cordas da guitarra</a> e o <a href="/aprender/jogo/">jogo de teoria musical</a> ajudam a fixar.
      </p>
    </section>

    <FAQ items={faqItems} />
  </div>
</BaseLayout>

<style>
  .chord-page { max-width: 560px; margin: 0 auto; padding: 2.5rem 1rem 4rem; }
  .chord-header { text-align: center; margin-bottom: 1.75rem; }
  .chord-header h1 { font-size: clamp(1.75rem, 4.5vw, 2.25rem); font-weight: 800; letter-spacing: -0.02em; }
  .chord-subtitle { color: var(--color-muted); margin-top: 0.4rem; font-size: 0.88rem; }
  .selector { margin-bottom: 1.25rem; }
  .selector-label {
    display: block; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--color-muted); font-weight: 700; margin-bottom: 0.6rem;
  }
  .root-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.4rem; }
  .quality-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.4rem; }
  @media (min-width: 480px) { .quality-grid { grid-template-columns: repeat(6, 1fr); } }
  .box {
    min-height: 44px; display: flex; align-items: center; justify-content: center;
    padding: 0.4rem 0.3rem; border-radius: 11px; border: 1px solid var(--color-border);
    background: var(--color-elevated); color: var(--color-foreground);
    font-weight: 700; font-size: 0.92rem; cursor: pointer; text-align: center;
    transition: border-color 0.12s, background 0.12s, color 0.12s, transform 0.06s;
  }
  .box:hover { border-color: var(--color-brand); }
  .box:active { transform: scale(0.95); }
  .box--active {
    background: var(--color-brand); border-color: var(--color-brand); color: #fff;
    box-shadow: 0 3px 10px rgba(230,57,70,0.3);
  }
  .quality-grid .box { font-size: 0.8rem; font-weight: 600; }
  .chord-result {
    background: var(--color-card); border: 1px solid var(--color-border); border-radius: 20px;
    padding: 1.5rem; text-align: center; margin-top: 0.25rem;
  }
  .chord-top { display: flex; align-items: center; justify-content: center; gap: 1rem; margin-bottom: 1.1rem; }
  .chord-name { font-size: 1.65rem; font-weight: 800; letter-spacing: -0.02em; }
  .play-chord-btn {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.5rem 1.1rem; border-radius: 999px; border: none;
    background: var(--color-brand); color: #fff; font-weight: 700; font-size: 0.85rem; cursor: pointer;
    box-shadow: 0 3px 10px rgba(230,57,70,0.28); transition: background 0.15s, transform 0.1s;
  }
  .play-chord-btn:hover { background: var(--color-brand-dark); }
  .play-chord-btn:active { transform: translateY(1px); }
  /* min-height reservado evita layout shift (CLS) ao injetar o SVG via JS */
  .chord-diagram { display: flex; justify-content: center; min-height: 200px; }
  .chord-diagram svg { width: 160px; max-width: 100%; height: auto; }
  .chord-note { font-size: 0.82rem; color: var(--color-subtle); margin-top: 0.9rem; min-height: 1.1em; }
  .chord-article { margin-top: 2.5rem; }
  .chord-article h2 { font-size: 1.35rem; font-weight: 700; margin-bottom: 1rem; }
  .chord-article p { line-height: 1.8; color: var(--color-muted); margin-bottom: 1.1rem; }
  .chord-article a { color: var(--color-brand); text-decoration: underline; text-underline-offset: 3px; }
  .chord-article strong { color: var(--color-foreground); }
</style>

<script>
  const NOTES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
  const OPEN_MIDI = [40, 45, 50, 55, 59, 64]; // cordas soltas E A D G B e (grave→agudo)

  const QUALITIES = [
    { key: 'maj', label: 'Maior', suffix: '' },
    { key: 'm', label: 'Menor', suffix: 'm' },
    { key: '7', label: '7', suffix: '7' },
    { key: 'm7', label: 'm7', suffix: 'm7' },
    { key: 'maj7', label: 'Maj7', suffix: 'maj7' },
    { key: 'sus4', label: 'sus4', suffix: 'sus4' },
  ];

  const E_SHAPE: Record<string, number[]> = {
    maj: [0, 2, 2, 1, 0, 0], m: [0, 2, 2, 0, 0, 0], '7': [0, 2, 0, 1, 0, 0],
    m7: [0, 2, 0, 0, 0, 0], sus4: [0, 2, 2, 2, 0, 0],
  };
  const A_SHAPE: Record<string, number[]> = {
    maj: [-1, 0, 2, 2, 2, 0], m: [-1, 0, 2, 2, 1, 0], '7': [-1, 0, 2, 0, 2, 0],
    m7: [-1, 0, 2, 0, 1, 0], maj7: [-1, 0, 2, 1, 2, 0], sus4: [-1, 0, 2, 2, 3, 0],
  };
  const OPEN: Record<string, number[]> = {
    'C-maj': [-1, 3, 2, 0, 1, 0], 'C-7': [-1, 3, 2, 3, 1, 0], 'C-maj7': [-1, 3, 2, 0, 0, 0],
    'D-maj': [-1, -1, 0, 2, 3, 2], 'D-m': [-1, -1, 0, 2, 3, 1], 'D-7': [-1, -1, 0, 2, 1, 2],
    'D-maj7': [-1, -1, 0, 2, 2, 2], 'D-sus4': [-1, -1, 0, 2, 3, 3],
    'E-maj': [0, 2, 2, 1, 0, 0], 'E-m': [0, 2, 2, 0, 0, 0], 'E-7': [0, 2, 0, 1, 0, 0],
    'E-m7': [0, 2, 0, 0, 0, 0], 'E-maj7': [0, 2, 1, 1, 0, 0],
    'G-maj': [3, 2, 0, 0, 0, 3], 'G-7': [3, 2, 0, 0, 0, 1], 'G-maj7': [3, 2, 0, 0, 0, 2],
    'A-maj': [-1, 0, 2, 2, 2, 0], 'A-m': [-1, 0, 2, 2, 1, 0], 'A-7': [-1, 0, 2, 0, 2, 0],
    'A-m7': [-1, 0, 2, 0, 1, 0], 'A-maj7': [-1, 0, 2, 1, 2, 0], 'A-sus4': [-1, 0, 2, 2, 3, 0],
    'B-7': [-1, 2, 1, 2, 0, 2],
  };

  type Shape = { frets: number[]; barreFret: number };

  function detectBarre(frets: number[]): number {
    const positive = frets.filter((f) => f > 0);
    if (!positive.length) return 0;
    const min = Math.min(...positive);
    const count = frets.filter((f) => f === min).length;
    return count >= 3 && min > 0 ? min : 0;
  }

  function buildShape(rootIdx: number, qual: string): Shape {
    const key = NOTES[rootIdx] + '-' + qual;
    if (OPEN[key]) { const frets = OPEN[key]; return { frets, barreFret: detectBarre(frets) }; }
    const rf6 = (rootIdx - 4 + 12) % 12;
    const rf5 = (rootIdx - 9 + 12) % 12;
    const eShape = E_SHAPE[qual];
    const aShape = A_SHAPE[qual];
    let barreFret: number, rel: number[];
    if (eShape && (!aShape || rf6 <= rf5)) { barreFret = rf6; rel = eShape; }
    else { barreFret = rf5; rel = aShape; }
    const frets = rel.map((r) => (r < 0 ? -1 : r + barreFret));
    return { frets, barreFret: barreFret > 0 ? barreFret : detectBarre(frets) };
  }

  function renderDiagram(frets: number[], barreFret: number): string {
    const played = frets.filter((f) => f > 0);
    const maxF = played.length ? Math.max(...played) : 1;
    const minF = played.length ? Math.min(...played) : 1;
    const base = maxF <= 5 ? 1 : minF;
    const FRETS = 5;
    const W = 200, H = 230;
    const padX = 24, padTop = 40, padBottom = 18;
    const gridW = W - padX * 2;
    const gridH = H - padTop - padBottom;
    const stringGap = gridW / 5;
    const fretGap = gridH / FRETS;
    const x = (s: number) => padX + s * stringGap;
    const yFret = (f: number) => padTop + f * fretGap;

    let svg = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Diagrama do acorde">`;

    if (base === 1) {
      svg += `<rect x="${padX - 1}" y="${padTop - 5}" width="${gridW + 2}" height="5" rx="2" fill="var(--color-foreground)"/>`;
    } else {
      svg += `<text x="${padX - 10}" y="${padTop + fretGap * 0.68}" fill="var(--color-muted)" font-size="13" font-weight="700" text-anchor="end">${base}ª</text>`;
    }
    for (let f = 0; f <= FRETS; f++) {
      svg += `<line x1="${padX}" y1="${yFret(f)}" x2="${padX + gridW}" y2="${yFret(f)}" stroke="var(--color-border)" stroke-width="1.5"/>`;
    }
    for (let s = 0; s < 6; s++) {
      svg += `<line x1="${x(s)}" y1="${padTop}" x2="${x(s)}" y2="${padTop + gridH}" stroke="var(--color-border)" stroke-width="1.5"/>`;
    }
    if (barreFret > 0) {
      const row = barreFret - base + 1;
      if (row >= 1 && row <= FRETS) {
        const strings = frets.map((f, i) => (f === barreFret ? i : -1)).filter((i) => i >= 0);
        const x1 = x(Math.min(...strings)), x2 = x(Math.max(...strings));
        const cy = yFret(row) - fretGap / 2;
        svg += `<rect x="${x1 - 7}" y="${cy - 7}" width="${x2 - x1 + 14}" height="14" rx="7" fill="var(--color-brand)" opacity="0.9"/>`;
      }
    }
    for (let s = 0; s < 6; s++) {
      const f = frets[s];
      const cx = x(s);
      if (f === -1) {
        svg += `<text x="${cx}" y="${padTop - 12}" fill="var(--color-subtle)" font-size="14" font-weight="700" text-anchor="middle">×</text>`;
      } else if (f === 0) {
        svg += `<circle cx="${cx}" cy="${padTop - 17}" r="5.5" fill="none" stroke="var(--color-muted)" stroke-width="1.6"/>`;
      } else {
        const row = f - base + 1;
        if (row >= 1 && row <= FRETS) {
          const cy = yFret(row) - fretGap / 2;
          svg += `<circle cx="${cx}" cy="${cy}" r="8" fill="var(--color-brand)"/>`;
        }
      }
    }
    svg += `</svg>`;
    return svg;
  }

  // ── Áudio realista: síntese Karplus-Strong (corda dedilhada) ──
  let audioCtx: AudioContext | null = null;
  function pluck(freq: number, when: number, vol: number) {
    if (!audioCtx) return;
    const sr = audioCtx.sampleRate;
    const N = Math.max(2, Math.round(sr / freq));
    const len = Math.floor(sr * 2.4);
    const buffer = audioCtx.createBuffer(1, len, sr);
    const data = buffer.getChannelData(0);
    const noise = new Float32Array(N);
    for (let i = 0; i < N; i++) noise[i] = Math.random() * 2 - 1;
    const damping = 0.9955;
    for (let i = 0; i < len; i++) {
      data[i] = i < N ? noise[i] : damping * 0.5 * (data[i - N] + data[i - N + 1]);
    }
    const src = audioCtx.createBufferSource();
    src.buffer = buffer;
    const lp = audioCtx.createBiquadFilter();
    lp.type = 'lowpass'; lp.frequency.value = 3600;
    const g = audioCtx.createGain();
    g.gain.setValueAtTime(vol, when);
    g.gain.exponentialRampToValueAtTime(0.0001, when + 2.3);
    src.connect(lp); lp.connect(g); g.connect(audioCtx.destination);
    src.start(when);
    src.stop(when + 2.4);
  }
  function playChord(frets: number[]) {
    if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const now = audioCtx.currentTime + 0.02;
    let i = 0;
    frets.forEach((f, s) => {
      if (f < 0) return;
      const midi = OPEN_MIDI[s] + f;
      const freq = 440 * Math.pow(2, (midi - 69) / 12);
      pluck(freq, now + i * 0.03, 0.16);
      i++;
    });
  }

  // ── Estado + UI ──
  let rootIdx = 0;
  let qualKey = 'maj';
  let currentFrets: number[] = [];

  const rootRow = document.getElementById('root-row')!;
  const qualityRow = document.getElementById('quality-row')!;
  const chordName = document.getElementById('chord-name')!;
  const diagram = document.getElementById('chord-diagram')!;
  const chordNote = document.getElementById('chord-note')!;
  const playBtn = document.getElementById('play-chord')!;

  rootRow.querySelectorAll<HTMLElement>('.box').forEach((b) => {
    b.addEventListener('click', () => { rootIdx = Number(b.dataset.root); markActive(rootRow, b); update(); });
  });
  qualityRow.querySelectorAll<HTMLElement>('.box').forEach((b) => {
    b.addEventListener('click', () => { qualKey = b.dataset.qual!; markActive(qualityRow, b); update(); });
  });

  function markActive(row: HTMLElement, active: HTMLElement) {
    row.querySelectorAll('.box').forEach((c) => c.classList.remove('box--active'));
    active.classList.add('box--active');
  }

  function update() {
    const qual = QUALITIES.find((q) => q.key === qualKey)!;
    const shape = buildShape(rootIdx, qual.key);
    currentFrets = shape.frets;
    chordName.textContent = NOTES[rootIdx] + qual.suffix;
    diagram.innerHTML = renderDiagram(shape.frets, shape.barreFret);
    chordNote.textContent = shape.barreFret > 0 ? 'Pestana na ' + shape.barreFret + 'ª casa' : 'Região aberta';
  }

  playBtn.addEventListener('click', () => playChord(currentFrets));

  update();
</script>
