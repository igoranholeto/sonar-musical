---
import BaseLayout from '../layouts/BaseLayout.astro';
import Afinador from '../components/Afinador.astro';

const faq = [
  {
    question: 'Como afinar o violão online pelo microfone?',
    answer: 'Selecione "Violão" e a afinação desejada, clique em "Ativar Microfone" e permita o acesso. Toque uma corda por vez: o afinador detecta a nota automaticamente e mostra se ela está grave (aperte a cravelha) ou aguda (afrouxe). Quando a agulha fica no centro e verde, a corda está afinada. Não precisa instalar nada, funciona direto no navegador do celular ou do computador.',
  },
  {
    question: 'Este afinador de violão e guitarra é grátis?',
    answer: 'Sim, é 100% gratuito e sem limites de uso. Você não precisa criar conta, baixar aplicativo nem pagar nada. O afinador funciona online, direto no navegador, usando o microfone do seu aparelho.',
  },
  {
    question: 'É melhor que o afinador do Google?',
    answer: 'O afinador do Google é ótimo para uma afinação padrão rápida, mas mostra apenas a nota. O nosso afinador é feito para músicos: traz afinações prontas para violão e guitarra (Standard, Drop D, Drop C, Open G/D/E, DADGAD, meio e um tom abaixo), mostra o desvio exato em cents, a direção do ajuste e destaca qual corda você está afinando.',
  },
  {
    question: 'Preciso instalar algum aplicativo ou dar permissão?',
    answer: 'Não é preciso instalar nada. Só é necessário permitir o acesso ao microfone quando o navegador pedir, o áudio é processado localmente, no seu próprio aparelho, e nada é gravado ou enviado para servidores.',
  },
  {
    question: 'O afinador funciona no celular?',
    answer: 'Sim. Funciona em celulares Android e iPhone, tablets e computadores, em navegadores como Chrome, Safari, Firefox e Edge. Basta abrir a página, permitir o microfone e tocar as cordas.',
  },
  {
    question: 'Qual a afinação padrão do violão e da guitarra?',
    answer: 'A afinação padrão das duas é E-A-D-G-B-E (Mi, Lá, Ré, Sol, Si, Mi), da sexta corda (mais grave) para a primeira (mais aguda). É a afinação "Standard (E)" que já vem selecionada. A partir dela você pode escolher variações como Drop D ou meio tom abaixo no menu de afinações.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Afinador Online de Guitarra e Violão, Sonar Musical',
    url: 'https://sonarmusical.com.br/afinador/',
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'Web',
    browserRequirements: 'Requer microfone e navegador com suporte a JavaScript',
    inLanguage: 'pt-BR',
    description: 'Afinador cromático online e gratuito para violão e guitarra, com detecção automática pelo microfone e afinações prontas (Standard, Drop D, Open G, DADGAD e mais).',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout
  title="Afinador Online de Violão e Guitarra, Grátis"
  description="Afinador de violão e guitarra online e grátis, pelo microfone. Detecção automática de notas e afinações prontas: Standard, Drop D, Open G e mais."
  schema={schema}
>
  <section class="tuner-page">
    <div class="tuner-header">
      <h1>Afinador Online de Violão e Guitarra</h1>
      <p class="tuner-subtitle">Microfone · Detecção automática · Grátis</p>
    </div>

    <Afinador instrumentos={['guitarra', 'violao']} />

    <!-- Info / SEO, layout em cards -->
    <div class="info-section">
      <div class="info-card">
        <div class="info-card__icon">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8" />
            <circle cx="12" cy="12" r="3" />
            <path d="M12 2v3M12 19v3M2 12h3M19 12h3" />
          </svg>
        </div>
        <h2 class="info-card__title">Como usar</h2>
        <p class="info-card__text">Clique em <strong>Ativar Microfone</strong>, permita o acesso e toque uma corda. A agulha no centro significa corda afinada.</p>
        <ul class="info-card__tips">
          <li><span class="tip-dot tip-dot--green"></span>Verde, afinado</li>
          <li><span class="tip-dot tip-dot--yellow"></span>Amarelo, ajuste pequeno</li>
          <li><span class="tip-dot tip-dot--red"></span>Vermelho, muito desafinado</li>
        </ul>
      </div>

      <div class="info-card">
        <div class="info-card__icon">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 7l-4 5 4 5" />
            <path d="M17 7l4 5-4 5" />
          </svg>
        </div>
        <h2 class="info-card__title">Lendo a agulha</h2>
        <p class="info-card__text">Agulha para a <strong>esquerda</strong>: nota baixa, aperte a cravelha. Agulha para a <strong>direita</strong>: nota alta, afrouxe.</p>
        <p class="info-card__text">O número em <em>cents</em> mostra o desvio exato. ±8 cents ou menos é considerado afinado.</p>
      </div>

      <div class="info-card">
        <div class="info-card__icon">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 6h16M4 12h16M4 18h16" />
            <circle cx="9" cy="6" r="1.6" fill="currentColor" stroke="none" />
            <circle cx="15" cy="12" r="1.6" fill="currentColor" stroke="none" />
            <circle cx="7" cy="18" r="1.6" fill="currentColor" stroke="none" />
          </svg>
        </div>
        <h2 class="info-card__title">Afinações</h2>
        <p class="info-card__text">Guitarra: Standard E, Drop D, Drop C, Open G/D/E, DADGAD, Half/Full Step Down.</p>
        <p class="info-card__text">Violão: Standard, Drop D, Open G/D, Nashville, DADGAD.</p>
      </div>
    </div>

    <!-- Conteúdo SEO ─────────────────────────────────────────── -->
    <div class="tuner-content">
      <h2>Afinador de violão e guitarra grátis, direto no navegador</h2>
      <p>
        Este é um <strong>afinador online</strong> gratuito que funciona pelo microfone do seu
        celular ou computador, sem instalar aplicativo e sem criar conta. Ele serve tanto como
        <strong>afinador de violão</strong> quanto como <strong>afinador de guitarra</strong>: basta
        escolher o instrumento, tocar uma corda por vez e seguir a agulha até o centro. A detecção é
        automática, então você não precisa apertar nada a cada corda.
      </p>

      <h2>Como afinar o violão ou a guitarra pelo microfone</h2>
      <ol>
        <li>Escolha <strong>Violão</strong> ou <strong>Guitarra</strong> no topo.</li>
        <li>Selecione a afinação (a padrão é <em>Standard E</em>: E-A-D-G-B-E).</li>
        <li>Clique em <strong>Ativar Microfone</strong> e permita o acesso.</li>
        <li>Toque uma corda solta. A nota aparece e a agulha mostra o desvio.</li>
        <li>Agulha à esquerda = grave (aperte a cravelha); à direita = aguda (afrouxe).</li>
        <li>Quando ficar verde e no centro, a corda está afinada. Repita nas seis.</li>
      </ol>
      <p>
        Se você está começando, vale entender o básico antes: veja o
        <a href="/blog/nome-das-cordas-da-guitarra/">nome das cordas da guitarra</a> e o guia de
        <a href="/blog/como-afinar-guitarra-guia-completo/">como afinar a guitarra</a> passo a passo.
      </p>

      <h2>Afinações disponíveis</h2>
      <p>
        Além da afinação padrão, o afinador traz as variações mais usadas, ótimas para rock, blues e
        metal: <strong>Drop D</strong>, <strong>Drop C</strong>, <strong>Open G</strong>,
        <strong>Open D</strong>, <strong>Open E</strong>, <strong>DADGAD</strong> e afinações
        <strong>meio tom</strong> e <strong>um tom abaixo</strong>. Conheça cada uma no guia de
        <a href="/blog/afinacoes-de-guitarra/">afinações de guitarra</a>. Cordas velhas dificultam a
        afinação e a mantêm instável, se a sua não segura o tom, talvez seja hora de trocar: veja as
        <a href="/blog/melhores-cordas-de-guitarra-2026/">melhores cordas de guitarra</a> e a diferença
        entre <a href="/blog/cordas-de-guitarra-009-ou-010/">calibres 009 e 010</a>.
      </p>

      <h2>É melhor que o afinador do Google?</h2>
      <p>
        O <em>afinador do Google</em> resolve uma afinação padrão rápida, mas mostra só a nota. Este
        afinador é feito para músicos: traz afinações prontas para violão e guitarra, mostra o desvio
        exato em <em>cents</em>, indica a direção do ajuste e destaca qual corda você está afinando, tudo de graça e sem instalar nada. Precisa de um metrônomo para treinar o ritmo? Use também o
        nosso <a href="/metronomo/">metrônomo online</a> e o
        <a href="/acordes/">dicionário de acordes</a>.
      </p>

      <h2>Afinador de cavaquinho, ukulele, viola e bandolim</h2>
      <p>
        Para outros instrumentos de corda, use a versão com as afinações de cada um já prontas:
        <a href="/afinador/cavaquinho/">afinador de cavaquinho</a> (Ré Sol Si Ré),
        <a href="/afinador/ukulele/">afinador de ukulele</a> (Sol Dó Mi Lá),
        <a href="/afinador/viola-caipira/">afinador de viola caipira</a> (Cebolão e Rio Abaixo) e
        <a href="/afinador/bandolim/">afinador de bandolim</a> (Sol Ré Lá Mi).
      </p>

      <!-- FAQ ──────────────────────────────────────────────────── -->
      <section class="tuner-faq" aria-label="Perguntas frequentes">
        <h2>Perguntas frequentes</h2>
        {faq.map((f) => (
          <details class="tuner-faq__item">
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </section>
    </div>
  </section>
</BaseLayout>
