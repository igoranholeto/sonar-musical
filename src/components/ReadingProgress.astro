---
// Barra de progresso de leitura (fixa no topo, abaixo do header) + botão
// "voltar ao topo" que aparece após rolar. Ambos são progressive enhancement:
// sem JS, nada quebra. Respeita prefers-reduced-motion.
---

<div
  id="reading-progress"
  class="reading-progress"
  role="progressbar"
  aria-label="Progresso de leitura"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
>
  <span id="reading-progress-bar" class="reading-progress__bar"></span>
</div>

<button id="back-to-top" type="button" class="back-to-top" aria-label="Voltar ao topo">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="12" y1="19" x2="12" y2="5" />
    <polyline points="5 12 12 5 19 12" />
  </svg>
</button>

<style>
  .reading-progress {
    position: fixed;
    top: 4rem; /* altura do header (h-16) */
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    z-index: 40;
    pointer-events: none;
  }
  .reading-progress__bar {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-brand);
    transform-origin: left;
    transition: width 0.1s linear;
  }

  .back-to-top {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--color-brand);
    color: #fff;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(230, 57, 70, 0.4);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .back-to-top:hover {
    background: var(--color-brand-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress__bar,
    .back-to-top {
      transition: none;
    }
  }
</style>

<script>
  const progress = document.getElementById('reading-progress');
  const bar = document.getElementById('reading-progress-bar');
  const backBtn = document.getElementById('back-to-top');

  if (progress && bar && backBtn) {
    let ticking = false;

    const update = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
      bar.style.width = pct + '%';
      progress.setAttribute('aria-valuenow', String(Math.round(pct)));
      backBtn.classList.toggle('is-visible', scrollTop > 600);
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();

    backBtn.addEventListener('click', () => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
  }
</script>
