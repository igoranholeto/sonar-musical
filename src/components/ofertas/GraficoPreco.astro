---
// Gráfico de degraus do preço registrado de um produto (SVG puro, sem JS). Cada degrau
// é um dia em que a checagem encontrou preço diferente; a linha vai até a última checagem.
import { fmtData, reais } from '../../utils/ofertas';

interface Props {
  pontos: { data: Date; preco: number }[];
  ate: Date;
}

const { pontos, ate } = Astro.props;
const W = 640;
const H = 220;
const M = { t: 16, r: 16, b: 28, l: 64 };
const t0 = pontos[0].data.valueOf();
const t1 = Math.max(ate.valueOf(), pontos.at(-1)!.data.valueOf(), t0 + 86400000);
const precos = pontos.map((p) => p.preco);
const pMin = Math.min(...precos);
const pMax = Math.max(...precos);
const folga = Math.max((pMax - pMin) * 0.25, pMax * 0.04);
const y0 = pMin - folga;
const y1 = pMax + folga;
const x = (t: number) => M.l + ((t - t0) / (t1 - t0)) * (W - M.l - M.r);
const y = (p: number) => M.t + (1 - (p - y0) / (y1 - y0)) * (H - M.t - M.b);

let d = `M${x(t0).toFixed(1)},${y(pontos[0].preco).toFixed(1)}`;
for (let i = 1; i < pontos.length; i++) {
  const px = x(pontos[i].data.valueOf()).toFixed(1);
  d += ` H${px} V${y(pontos[i].preco).toFixed(1)}`;
}
d += ` H${x(t1).toFixed(1)}`;
const area = `${d} V${H - M.b} H${M.l} Z`;
const ticks = pMin === pMax ? [pMin] : [pMin, pMax];
---

<figure class="gp">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Histórico de preço: ${pontos.map((p) => `${fmtData(p.data)} ${reais(p.preco)}`).join(', ')}`}>
    {ticks.map((p) => (
      <g>
        <line x1={M.l} x2={W - M.r} y1={y(p)} y2={y(p)} class="gp__grade" />
        <text x={M.l - 8} y={y(p) + 4} text-anchor="end" class="gp__rot">{reais(p)}</text>
      </g>
    ))}
    <path d={area} class="gp__area" />
    <path d={d} class="gp__linha" />
    {pontos.map((p) => (
      <circle cx={x(p.data.valueOf())} cy={y(p.preco)} r="4.5" class:list={['gp__ponto', { 'gp__ponto--min': p.preco === pMin && pMin !== pMax }]}>
        <title>{`${fmtData(p.data)}: ${reais(p.preco)}`}</title>
      </circle>
    ))}
    <text x={M.l} y={H - 8} class="gp__rot">{fmtData(pontos[0].data)}</text>
    <text x={W - M.r} y={H - 8} text-anchor="end" class="gp__rot">{fmtData(new Date(t1))}</text>
  </svg>
</figure>

<style>
  .gp { margin: 0; }
  .gp svg { display: block; width: 100%; height: auto; }
  .gp__grade { stroke: var(--color-border); stroke-dasharray: 3 4; }
  .gp__rot { fill: var(--color-subtle); font-size: 12px; }
  .gp__area { fill: var(--color-brand); opacity: 0.08; }
  .gp__linha { fill: none; stroke: var(--color-brand); stroke-width: 2.5; stroke-linejoin: round; }
  .gp__ponto { fill: var(--color-card); stroke: var(--color-brand); stroke-width: 2.5; }
  .gp__ponto--min { fill: #15803d; stroke: #15803d; }
  :global(.dark) .gp__ponto--min { fill: #4ade80; stroke: #4ade80; }
</style>
