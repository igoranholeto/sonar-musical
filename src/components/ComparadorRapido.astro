---
// "Comparador rápido" — atalhos para os guias de confronto (X vs Y) que já
// existem no blog. Zero-JS, 100% links crawláveis: bom p/ interlinking interno
// e captura leitores em dúvida de compra (alta intenção). Cada confronto aponta
// para um post real.
interface Confronto {
  contexto: string;
  a: string;
  b: string;
  href: string;
}

const confrontos: Confronto[] = [
  { contexto: 'Guitarras', a: 'Fender', b: 'Gibson', href: '/blog/fender-vs-gibson-qual-escolher/' },
  { contexto: 'Amplificadores', a: 'Valvulado', b: 'Transistor', href: '/blog/amplificador-valvulado-ou-transistor/' },
  { contexto: 'Captadores', a: 'Passivo', b: 'Ativo', href: '/blog/captacoes-guitarra-passivas-vs-ativas/' },
  { contexto: 'Cordas', a: '009', b: '010', href: '/blog/cordas-de-guitarra-009-ou-010/' },
  { contexto: 'Iniciantes', a: 'Violão', b: 'Guitarra', href: '/blog/violao-ou-guitarra-por-onde-comecar/' },
];
---

<section class="py-12 px-4">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-7">
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand mb-2">
        <span class="w-1.5 h-1.5 bg-brand rounded-full" aria-hidden="true"></span>
        Bateu a dúvida?
      </span>
      <h2 class="text-2xl sm:text-3xl font-black">Comparador rápido</h2>
      <p class="text-sm text-muted mt-2">Os confrontos que todo guitarrista pesquisa antes de comprar — resolvidos.</p>
    </div>

    <div class="comparador">
      {confrontos.map((c) => (
        <a href={c.href} class="confronto" aria-label={`${c.a} ou ${c.b}? (${c.contexto})`}>
          <span class="confronto__contexto">{c.contexto}</span>
          <span class="confronto__duelo">
            <span class="confronto__lado">{c.a}</span>
            <span class="confronto__vs" aria-hidden="true">VS</span>
            <span class="confronto__lado">{c.b}</span>
          </span>
          <span class="confronto__cta" aria-hidden="true">
            Ver comparação
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .comparador {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
  }
  .confronto {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    padding: 1.4rem 1rem;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    text-decoration: none;
    text-align: center;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .confronto:hover {
    transform: translateY(-3px);
    border-color: var(--color-brand);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
  }
  .confronto__contexto {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-subtle);
  }
  .confronto__duelo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .confronto__lado {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }
  .confronto__vs {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-brand);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.02em;
  }
  .confronto__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-brand);
  }
  .confronto__cta svg {
    transition: transform 0.15s ease;
  }
  .confronto:hover .confronto__cta svg {
    transform: translateX(3px);
  }
</style>
