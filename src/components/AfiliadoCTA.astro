---
import { ORG_ID, absUrl, detectMarca, organizationRef, personRef, productId } from '../utils/schema';

interface Props {
  produto: string;
  descricao?: string;
  url: string;
  preco?: string;
  imagem?: string;
  imagemAlt?: string;
  avaliacao?: number;
  destaques?: string[];
  badge?: string;
  categoria?: 'guitarra' | 'violao' | 'pedal' | 'pedaleira' | 'amplificador' | 'cordas' | 'interface' | 'acessorio';
}

const {
  produto,
  descricao,
  url,
  preco,
  imagem,
  imagemAlt,
  avaliacao,
  destaques,
  badge,
} = Astro.props;

// Detecta a marca a partir do nome do produto
const marca = detectMarca(produto);

// Cores de marca para o chip (bg + texto)
const marcaCores: Record<string, { bg: string; text: string }> = {
  'Fender':            { bg: '#1a1a2e', text: '#6ea8d8' },
  'Squier':            { bg: '#1a1a2e', text: '#6ea8d8' },
  'Gibson':            { bg: '#1e1a0a', text: '#d4a843' },
  'Epiphone':          { bg: '#1e1a0a', text: '#d4a843' },
  'Ibanez':            { bg: '#0a1a1a', text: '#5bc4c4' },
  'Marshall':          { bg: '#1e1800', text: '#e0bc30' },
  'Yamaha':            { bg: '#14001a', text: '#c07ad4' },
  'Boss':              { bg: '#1a0000', text: '#e05555' },
  'Orange':            { bg: '#1a0d00', text: '#e07830' },
  'Blackstar':         { bg: '#0a0a14', text: '#7878d4' },
  'Focusrite':         { bg: '#1a0a0a', text: '#e05050' },
  'Universal Audio':   { bg: '#0a0a0a', text: '#c0c0c0' },
  'SSL':               { bg: '#001a0a', text: '#44cc88' },
  'Audient':           { bg: '#0a0a14', text: '#8888cc' },
  'Native Instruments':{ bg: '#0a0a0a', text: '#aaaaaa' },
  'Line 6':            { bg: '#00100a', text: '#44bb88' },
  'Neural DSP':        { bg: '#0a0a14', text: '#7a88ee' },
  'Ernie Ball':        { bg: '#1a000a', text: '#cc5580' },
  "D'Addario":         { bg: '#000a1a', text: '#5588dd' },
  'Elixir':            { bg: '#001a05', text: '#44aa55' },
  'GHS':               { bg: '#1a0500', text: '#cc6622' },
  'Taylor':            { bg: '#0a0a00', text: '#bbaa44' },
  'Martin':            { bg: '#100800', text: '#cc9944' },
  'PRS':               { bg: '#140014', text: '#cc66cc' },
  'Schecter':          { bg: '#0a0000', text: '#cc4444' },
  'ESP':               { bg: '#0a0a0a', text: '#999999' },
  'Zoom':              { bg: '#001420', text: '#4499cc' },
};

// Aplica a cor da marca no chip via CSS custom properties no elemento raiz
const cardStyle = marca && marcaCores[marca]
  ? `--afi-chip-bg:${marcaCores[marca].bg};--afi-chip-fg:${marcaCores[marca].text};`
  : '';

// Sem nota explícita não exibe estrelas nem emite Review: nota padrão seria uma
// avaliação que a redação não deu.
const avaliacaoLabel = avaliacao != null ? avaliacao.toFixed(1) : null;
const pct = avaliacao != null ? Math.round((avaliacao / 5) * 1000) / 10 : 0; // preenchimento das estrelas (%)

const badgeText = badge ?? 'Recomendação Sonar';

// Destaques condensados numa linha; a descrição é o fallback quando não há destaques
const specsLine = destaques && destaques.length > 0 ? destaques.slice(0, 3).join(' · ') : null;
const showDesc = !specsLine && descricao;

// Preço sem o prefixo "A partir de" (o rótulo já é exibido acima)
const precoValor = preco ? preco.replace(/^\s*a partir de\s*/i, '') : null;

// ── Schema Product + Review + Offer (avaliação editorial da redação) ─────
// Objetivo: habilitar rich result de estrelas no Google. A review é assinada pelo
// autor do post (Astro.locals.post, preenchido em blog/[slug].astro) e cai para a
// Organization fora de posts. O @id por página+produto deixa o Google fundir este nó
// com o Product do PostLayout quando o post é review do mesmo item; nesse caso a
// review já está lá e aqui só entra a offer.
function parsePreco(p?: string): string | null {
  if (!p) return null;
  let s = p.replace(/a partir de/i, '').replace(/r\$/i, '').replace(/[^0-9.,]/g, '');
  if (!s) return null;
  s = s.includes(',') ? s.replace(/\./g, '').replace(',', '.') : s.replace(/\./g, '');
  const n = parseFloat(s);
  return Number.isFinite(n) && n > 0 ? n.toFixed(2) : null;
}
const precoNum = parsePreco(preco);
const imagemAbs = imagem ? absUrl(imagem) : null;

const post = Astro.locals.post;
const pageUrl = post?.url ?? new URL(Astro.url.pathname, Astro.site).href;
const id = productId(pageUrl, produto);
const reviewNoPost = post?.reviewedProductId === id;

const review =
  avaliacao != null && !reviewNoPost
    ? {
        '@type': 'Review',
        reviewRating: { '@type': 'Rating', ratingValue: Number(avaliacao.toFixed(1)), bestRating: 5, worstRating: 1 },
        author: post?.author ? personRef(post.author) : organizationRef,
        publisher: { '@id': ORG_ID },
        ...(post && { datePublished: post.pubDate.toISOString() }),
      }
    : null;

const offer = precoNum
  ? {
      '@type': 'Offer',
      price: precoNum,
      priceCurrency: 'BRL',
      availability: 'https://schema.org/InStock',
      url,
    }
  : null;

// Product exige review, offers ou aggregateRating; sem nenhum dos dois, nada é emitido.
// No caso do produto revisado no próprio post o nó do PostLayout já carrega a review.
const produtoSchema: Record<string, unknown> | null =
  review || offer || reviewNoPost
    ? {
        '@context': 'https://schema.org',
        '@type': 'Product',
        '@id': id,
        name: produto,
        ...(marca ? { brand: { '@type': 'Brand', name: marca } } : {}),
        ...(imagemAbs ? { image: imagemAbs } : {}),
        ...(descricao ? { description: descricao } : {}),
        ...(review ? { review } : {}),
        ...(offer ? { offers: offer } : {}),
      }
    : null;
---

{produtoSchema && <script type="application/ld+json" set:html={JSON.stringify(produtoSchema)} />}

<!-- Divulgação de afiliado. O CSS exibe esta linha apenas no PRIMEIRO
     AfiliadoCTA da página (regra .afi ~ .afi-disclosure), atendendo à
     transparência exigida sem repetir o aviso em cada bloco nem editar os posts. -->
<p class="afi-disclosure">
  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
  <span>Este artigo contém links de afiliado. Se você comprar por eles, podemos receber uma comissão sem custo extra para você, o que não influencia nossas análises.</span>
</p>

<article class="afi" style={cardStyle}>
  <div class="afi__main">
    {imagem && (
      <div class="afi__media">
        <img class="afi__img" src={imagem} alt={imagemAlt || produto} width="84" height="84" loading="lazy" decoding="async" />
        <div class="afi__shadow" aria-hidden="true"></div>
      </div>
    )}

    <div class="afi__body">
      <div class="afi__meta">
        <span class="afi__badge">{badgeText}</span>
        {marca && <span class="afi__sep" aria-hidden="true"></span>}
        {marca && <span class="afi__chip">{marca}</span>}
      </div>

      <h3 class="afi__title">{produto}</h3>

      {avaliacaoLabel && (
        <div class="afi__rating" aria-label={`Avaliação: ${avaliacaoLabel} de 5`}>
          <span class="afi__stars" aria-hidden="true">★★★★★<span style={`--pct:${pct}%`}>★★★★★</span></span>
          <span class="afi__rating-text">{avaliacaoLabel} · Avaliação da redação</span>
        </div>
      )}

      {specsLine && <div class="afi__specs">{specsLine}</div>}
      {showDesc && <p class="afi__desc">{descricao}</p>}
    </div>
  </div>

  <div class="afi__action">
    {precoValor && (
      <div class="afi__price-group">
        <span class="afi__price-label">A partir de</span>
        <span class="afi__price">{precoValor}</span>
      </div>
    )}

    <a class="afi__btn" href={url} target="_blank" rel="noopener noreferrer sponsored nofollow">
      Ver melhor preço
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>

    <span class="afi__trust">Compra segura · nova aba</span>
  </div>
</article>

<style>
  /* Os seletores dos filhos são prefixados com .afi de propósito: o card vive
     dentro de .prose-post, cujos seletores globais (h3, p, img, a...) têm mais
     especificidade que uma classe simples com o escopo do Astro. O prefixo .afi
     garante que o layout do card sempre vença o estilo do corpo do artigo. */

  /* ── Divulgação de afiliado ─────────────────────────────── */
  .afi-disclosure {
    display: flex !important;
    align-items: flex-start;
    gap: 0.45rem;
    margin: 2.75rem 0 -1.25rem !important;
    font-size: 11px !important;
    line-height: 1.5 !important;
    color: rgba(255, 255, 255, 0.3) !important;
  }
  .afi-disclosure svg { flex-shrink: 0; margin-top: 0.15em; opacity: 0.7; }
  /* Mostra o aviso só no PRIMEIRO card da página: qualquer .afi-disclosure
     que venha depois de um .afi (2º bloco em diante) fica oculto. */
  .afi ~ .afi-disclosure { display: none !important; }

  /* ── Card ───────────────────────────────────────────────── */
  .afi {
    --afi-brand: #e63946;
    --afi-brand-hover: #d02f3c;
    --afi-brand-active: #b8202d;
    --afi-bg: #111214;
    --afi-border: rgba(255, 255, 255, 0.07);
    --afi-price: #4ade80;
    --afi-star: #facc15;
    --afi-star-empty: rgba(255, 255, 255, 0.12);
    /* chip de marca (sobrescrito por marca via style inline) */
    --afi-chip-bg: rgba(255, 255, 255, 0.06);
    --afi-chip-fg: rgba(255, 255, 255, 0.7);

    display: flex;
    align-items: center;
    gap: 20px;
    margin: 2.75rem 0;
    padding: 16px 20px;
    background: var(--afi-bg);
    border: 1px solid var(--afi-border);
    border-left: 3px solid var(--afi-brand);
    border-radius: 14px;
    font-family: inherit;
  }

  /* ── Foto recortada (PNG/WebP transparente) ─────────────── */
  .afi .afi__media { flex: 0 0 84px; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .afi .afi__img { display: block; width: 84px; height: 84px; object-fit: contain; margin: 0; border-radius: 0; }
  .afi .afi__shadow {
    width: 70px; height: 10px; border-radius: 50%;
    background: radial-gradient(50% 100% at 50% 0%, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0) 75%);
  }

  .afi .afi__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }

  .afi .afi__meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .afi .afi__badge {
    font-size: 9px; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase;
    color: #ff6b76;
  }
  .afi .afi__sep { width: 1px; height: 10px; background: rgba(255, 255, 255, 0.15); }
  .afi .afi__chip {
    padding: 2px 7px; border-radius: 4px;
    background: var(--afi-chip-bg); color: var(--afi-chip-fg);
    font-size: 9px; font-weight: 800; letter-spacing: 0.09em; text-transform: uppercase;
    line-height: 1.4;
  }

  .afi .afi__title {
    margin: 0; font-size: 21px; line-height: 1.15; font-weight: 800; letter-spacing: -0.02em;
    color: #f5f5f5; text-wrap: pretty;
  }

  .afi .afi__rating { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .afi .afi__stars {
    position: relative; display: inline-block; line-height: 1;
    font-size: 12px; letter-spacing: 1px; color: var(--afi-star-empty);
  }
  .afi .afi__stars > span {
    position: absolute; top: 0; left: 0; width: var(--pct, 100%);
    overflow: hidden; white-space: nowrap; color: var(--afi-star);
  }
  .afi .afi__rating-text { font-size: 12px; color: rgba(255, 255, 255, 0.45); }

  .afi .afi__specs { font-size: 12px; line-height: 1.5; color: rgba(255, 255, 255, 0.6); margin: 0; }
  .afi .afi__desc { margin: 0; font-size: 13px; line-height: 1.55; color: rgba(255, 255, 255, 0.55); }

  /* ── Bloco de conversão (preço + botão) ─────────────────── */
  .afi .afi__action { flex: 0 0 auto; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  .afi .afi__price-label {
    font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
  }
  .afi .afi__price {
    font-size: 26px; font-weight: 900; letter-spacing: -0.03em; line-height: 1;
    color: var(--afi-price);
  }
  .afi .afi__btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 18px; border-radius: 9px;
    background: var(--afi-brand); color: #fff !important;
    font-size: 14px; font-weight: 800; white-space: nowrap; text-decoration: none !important;
    box-shadow: 0 8px 20px rgba(230, 57, 70, 0.28);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .afi .afi__btn:hover { background: var(--afi-brand-hover); color: #fff !important; text-decoration: none !important; }
  .afi .afi__btn:active { background: var(--afi-brand-active); transform: translateY(1px); }
  .afi .afi__btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .afi .afi__btn svg { width: 15px; height: 15px; flex: 0 0 auto; }
  .afi .afi__trust { font-size: 10px; color: rgba(255, 255, 255, 0.3); }

  /* ── Mobile: empilhado ──────────────────────────────────── */
  @media (max-width: 600px) {
    .afi { flex-direction: column; align-items: stretch; gap: 14px; padding: 16px; }
    .afi .afi__main { display: flex; align-items: center; gap: 14px; }
    .afi .afi__media { flex: 0 0 76px; }
    .afi .afi__img { width: 76px; height: 76px; }
    .afi .afi__shadow { width: 64px; height: 9px; }
    .afi .afi__title { font-size: 19px; }
    .afi .afi__action {
      flex-direction: row; align-items: center; justify-content: space-between; gap: 12px;
      padding-top: 12px; border-top: 1px solid var(--afi-border);
    }
    .afi .afi__price-group { display: flex; flex-direction: column; gap: 1px; }
    .afi .afi__price { font-size: 24px; }
    .afi .afi__btn { padding: 13px 18px; }
    .afi .afi__trust { display: none; }
  }
  /* Desktop: o wrapper .afi__main é transparente ao layout flex do card */
  @media (min-width: 601px) {
    .afi .afi__main { display: contents; }
    .afi .afi__price-group { display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
  }
</style>
