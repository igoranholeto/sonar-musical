---
---

<section id="newsletter" class="py-16 px-4">
  <div class="max-w-2xl mx-auto text-center">
    <div class="bg-elevated border border-border rounded-2xl p-10">
      <div class="inline-flex items-center justify-center w-14 h-14 bg-brand/10 rounded-xl mb-6" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#e63946" stroke-width="2" stroke-linecap="round">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
      </div>
      <h2 class="text-2xl font-bold mb-3">Alerta de preço</h2>
      <p class="text-muted mb-8">
        Receba as quedas de preço dos instrumentos dos nossos guias e o resumo de Black Friday e Natal com o que realmente baixou.
      </p>
      <form
        class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
        aria-label="Inscrição na newsletter"
        name="newsletter"
        method="POST"
        action="/newsletter/confirme/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <!-- Netlify Forms: identifica o formulário no processamento do deploy -->
        <input type="hidden" name="form-name" value="newsletter" />
        <!-- Honeypot anti-spam: invisível para humanos, preenchido por bots -->
        <p class="hidden" aria-hidden="true">
          <label>Não preencha: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <label for="email-input" class="sr-only">Endereço de e-mail</label>
        <input
          id="email-input"
          type="email"
          name="email"
          placeholder="seu@email.com"
          autocomplete="email"
          required
          class="flex-1 px-4 py-3 rounded-xl bg-card border border-border text-foreground placeholder-subtle text-sm focus:outline-none focus:border-brand transition-colors"
        />
        <button
          type="submit"
          class="px-6 py-3 bg-brand-fill text-white font-semibold rounded-xl hover:bg-brand-dark transition-colors whitespace-nowrap shadow-lg shadow-brand/20"
        >
          Inscrever-se
        </button>
      </form>
      <p class="text-xs text-subtle mt-4">
        No máximo um e-mail por semana. Cancele com um clique.
        Veja a <a href="/privacidade/" class="underline hover:text-foreground">política de privacidade</a>.
      </p>
    </div>
  </div>
</section>
