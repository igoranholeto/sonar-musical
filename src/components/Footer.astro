---
import { slugifyCategory } from '../utils/slug';

const categories = ['Guitarras', 'Amplificadores', 'Pedais', 'Acessórios', 'Guias de Compra', 'Dicas para Iniciantes'];

const links = [
  { href: '/blog/', label: 'Todas as Análises' },
  { href: '/afinador/', label: 'Afinador Online' },
  { href: '/metronomo/', label: 'Metrônomo Online' },
  { href: '/acordes/', label: 'Dicionário de Acordes' },
  { href: '/about/', label: 'Sobre Nós' },
  { href: '/contact/', label: 'Contato' },
  { href: '/creditos/', label: 'Créditos de Imagem' },
  { href: '/rss.xml', label: 'Feed RSS' },
  { href: '/llms.txt', label: 'llms.txt' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-auto">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- Coluna da marca -->
      <div class="sm:col-span-2 lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-2 font-bold text-xl mb-4">
          <span class="flex items-center justify-center w-8 h-8 bg-brand rounded-lg text-white" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M9 18V5l12-2v13" />
              <circle cx="6" cy="18" r="3" />
              <circle cx="18" cy="16" r="3" />
            </svg>
          </span>
          Sonar<span class="text-brand">Musical</span>
        </a>
        <p class="text-muted text-sm leading-relaxed max-w-xs">
          Análises honestas, guias de compra e dicas para guitarristas de todos os níveis. Te ajudamos a encontrar o equipamento certo sem enrolação.
        </p>

        <!-- Contato & redes -->
        <div class="mt-6 flex items-center gap-3">
          <a
            href="https://www.instagram.com/sonar_musical"
            rel="me noopener noreferrer"
            target="_blank"
            aria-label="Sonar Musical no Instagram"
            class="flex items-center justify-center w-10 h-10 rounded-xl border border-border text-muted hover:text-white hover:border-brand hover:bg-brand transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a
            href="https://www.pinterest.com/sonarmusical/"
            rel="me noopener noreferrer"
            target="_blank"
            aria-label="Sonar Musical no Pinterest"
            class="flex items-center justify-center w-10 h-10 rounded-xl border border-border text-muted hover:text-white hover:border-brand hover:bg-brand transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345c-.091.378-.293 1.194-.333 1.362-.052.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.966 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.379l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12C24 5.372 18.627 0 12 0z"/>
            </svg>
          </a>
          <a
            href="mailto:oi@sonarmusical.com.br"
            aria-label="Enviar e-mail para o Sonar Musical"
            class="flex items-center justify-center w-10 h-10 rounded-xl border border-border text-muted hover:text-white hover:border-brand hover:bg-brand transition-colors"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </a>
          <a
            href="mailto:oi@sonarmusical.com.br"
            class="text-sm text-muted hover:text-foreground transition-colors"
          >
            oi@sonarmusical.com.br
          </a>
        </div>
      </div>

      <!-- Links rápidos -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-muted mb-4">Links Rápidos</h3>
        <ul class="space-y-2.5">
          {links.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-muted hover:text-foreground transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Categorias -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-muted mb-4">Categorias</h3>
        <ul class="space-y-2.5">
          {categories.map((cat) => (
            <li>
              <a
                href={`/categoria/${slugifyCategory(cat)}/`}
                class="text-sm text-muted hover:text-foreground transition-colors"
              >
                {cat}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Rodapé inferior -->
    <div class="border-t border-border pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-muted">
      <p>&copy; {year} Sonar Musical. Todos os direitos reservados.</p>
      <p>Feito com <a href="https://astro.build" class="hover:text-foreground transition-colors underline underline-offset-2" rel="noopener noreferrer" target="_blank">Astro</a></p>
    </div>
  </div>
</footer>
