---
import { slugifyCategory } from '../utils/slug';

const navLinks = [
  { href: '/', label: 'Início' },
  { href: '/bandas/', label: 'Bandas' },
  { href: '/aprender/', label: 'Aprender' },
  { href: '/about/', label: 'Sobre' },
  { href: '/contact/', label: 'Contato' },
];

// Ferramentas grátis agrupadas em dropdown para não estourar a barra de navegação
const ferramentas = [
  { href: '/ferramentas/', label: 'Todas as Ferramentas' },
  { href: '/afinador/', label: 'Afinador' },
  { href: '/metronomo/', label: 'Metrônomo' },
  { href: '/acordes/', label: 'Dicionário de Acordes' },
  { href: '/gerador-de-escalas/', label: 'Gerador de Escalas' },
  { href: '/qual-guitarra/', label: 'Qual Guitarra é pra Você?' },
  { href: '/tablaturas/', label: 'Tablaturas' },
];

// Subcategorias com maior potencial de SEO (volume de busca real, via keyword research)
const analiseCategorias = [
  'Guitarras',
  'Amplificadores',
  'Pedais',
  'Acessórios',
  'Violões',
  'Guias de Compra',
  'Técnica e Teoria',
];

const currentPath = Astro.url.pathname;
const isAnalisesActive = currentPath.startsWith('/blog') || currentPath.startsWith('/categoria');
const isFerramentasActive = ferramentas.some(({ href }) => currentPath.startsWith(href));
---

<header class="sticky top-0 z-50 bg-surface/90 backdrop-blur-md border-b border-border">
  <nav class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between" aria-label="Navegação principal">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-bold text-xl group" aria-label="SonarMusical: página inicial">
      <span class="flex items-center justify-center w-8 h-8 bg-brand-fill rounded-lg text-white" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M9 18V5l12-2v13" />
          <circle cx="6" cy="18" r="3" />
          <circle cx="18" cy="16" r="3" />
        </svg>
      </span>
      <span class="group-hover:text-brand transition-colors">
        Sonar<span class="text-brand">Musical</span>
      </span>
    </a>

    <!-- Nav desktop -->
    <ul class="hidden lg:flex items-center gap-0.5" role="list">
      <li>
        <a
          href="/"
          aria-current={currentPath === '/' ? 'page' : undefined}
          class={`px-3 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors ${
            currentPath === '/'
              ? 'text-brand bg-brand/10'
              : 'text-muted hover:text-foreground hover:bg-foreground/5'
          }`}
        >
          Início
        </a>
      </li>

      <!-- Análises com dropdown de subcategorias -->
      <li class="relative" id="analises-menu-item">
        <div
          class={`flex items-center rounded-lg transition-colors ${
            isAnalisesActive ? 'text-brand bg-brand/10' : 'text-muted hover:text-foreground hover:bg-foreground/5'
          }`}
        >
          <a
            href="/blog/"
            aria-current={isAnalisesActive ? 'page' : undefined}
            class="pl-3 pr-1.5 py-2 text-sm font-medium whitespace-nowrap"
          >
            Análises
          </a>
          <button
            id="analises-dropdown-btn"
            type="button"
            aria-expanded="false"
            aria-controls="analises-dropdown"
            aria-label="Ver categorias de análises"
            class="pr-2.5 py-2"
          >
            <svg id="analises-dropdown-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </div>

        <div
          id="analises-dropdown"
          class="hidden absolute left-0 top-full mt-1 w-56 rounded-xl border border-border bg-card shadow-lg py-2 z-50"
          role="menu"
        >
          {analiseCategorias.map((cat) => (
            <a
              href={`/categoria/${slugifyCategory(cat)}/`}
              role="menuitem"
              class="block px-4 py-2 text-sm text-muted hover:text-foreground hover:bg-foreground/5 transition-colors"
            >
              {cat}
            </a>
          ))}
          <div class="my-1.5 border-t border-border"></div>
          <a
            href="/blog/"
            role="menuitem"
            class="block px-4 py-2 text-sm font-semibold text-brand hover:bg-foreground/5 transition-colors"
          >
            Ver todas as análises →
          </a>
        </div>
      </li>

      <!-- Black Friday: botão com borda de luz girando para chamar a atenção -->
      <li class="mx-1">
        <a href="/black-friday/" class:list={['bf-btn', { 'is-on': currentPath.startsWith('/black-friday') || currentPath.startsWith('/produto/') }]} aria-current={currentPath.startsWith('/black-friday') ? 'page' : undefined}>
          <svg class="bf-btn__ico" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c.6 3.2-1 5.1-2.6 6.9C7.8 10.7 6 12.6 6 15.5A6 6 0 0 0 18 15.5c0-2.3-1-4.1-2.2-5.4-.3 1.6-1.1 2.7-2.3 3.2.4-3.6-.4-7.6-1.5-11.3z"/></svg>
          <span>Black Friday</span>
        </a>
      </li>

      <!-- Ferramentas com dropdown -->
      <li class="relative" id="ferramentas-menu-item">
        <button
          id="ferramentas-dropdown-btn"
          type="button"
          aria-expanded="false"
          aria-controls="ferramentas-dropdown"
          class={`flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors ${
            isFerramentasActive ? 'text-brand bg-brand/10' : 'text-muted hover:text-foreground hover:bg-foreground/5'
          }`}
        >
          Ferramentas
          <svg id="ferramentas-dropdown-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>

        <div
          id="ferramentas-dropdown"
          class="hidden absolute left-0 top-full mt-1 w-56 rounded-xl border border-border bg-card shadow-lg py-2 z-50"
          role="menu"
        >
          {ferramentas.map(({ href, label }) => (
            <a
              href={href}
              role="menuitem"
              aria-current={currentPath.startsWith(href) ? 'page' : undefined}
              class="block px-4 py-2 text-sm text-muted hover:text-foreground hover:bg-foreground/5 transition-colors"
            >
              {label}
            </a>
          ))}
        </div>
      </li>

      {navLinks.filter(({ href }) => href !== '/').map(({ href, label }) => {
        const isActive = currentPath.startsWith(href);
        return (
          <li>
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              class={`px-3 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition-colors ${
                isActive
                  ? 'text-brand bg-brand/10'
                  : 'text-muted hover:text-foreground hover:bg-foreground/5'
              }`}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>

    <div class="flex items-center gap-2">
      <!-- Black Friday no celular/tablet (o menu desktop some abaixo de lg) -->
      <a href="/black-friday/" class="bf-btn bf-btn--compacto lg:hidden" aria-label="Ofertas da Black Friday">
        <svg class="bf-btn__ico" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c.6 3.2-1 5.1-2.6 6.9C7.8 10.7 6 12.6 6 15.5A6 6 0 0 0 18 15.5c0-2.3-1-4.1-2.2-5.4-.3 1.6-1.1 2.7-2.3 3.2.4-3.6-.4-7.6-1.5-11.3z"/></svg>
        <span>BF</span>
      </a>
      <!-- Busca -->
      <a
        id="busca-btn"
        href="/busca/"
        aria-label="Buscar no site"
        aria-controls="busca-pop"
        aria-expanded="false"
        aria-current={currentPath.startsWith('/busca') ? 'page' : undefined}
        class={`p-2 rounded-lg transition-colors ${
          currentPath.startsWith('/busca')
            ? 'text-brand bg-brand/10'
            : 'text-muted hover:text-foreground hover:bg-foreground/5'
        }`}
      >
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8" />
          <line x1="21" y1="21" x2="16.65" y2="16.65" />
        </svg>
        <span class="sr-only">Buscar no site</span>
      </a>

      <!-- Toggle de tema claro/escuro -->
      <button
        id="theme-toggle"
        type="button"
        role="switch"
        aria-checked="true"
        aria-label="Alternar entre tema claro e escuro"
        class="relative inline-flex h-8 w-14 flex-shrink-0 items-center rounded-full border border-border bg-elevated transition-colors"
      >
        <span
          id="theme-toggle-thumb"
          class="flex h-6 w-6 translate-x-1 items-center justify-center rounded-full bg-card shadow-md transition-transform duration-300 dark:translate-x-7"
        >
          <svg id="icon-sun" class="block dark:hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f5b700" stroke-width="2.5" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <line x1="12" y1="2" x2="12" y2="4.5" />
            <line x1="12" y1="19.5" x2="12" y2="22" />
            <line x1="4.2" y1="4.2" x2="6" y2="6" />
            <line x1="18" y1="18" x2="19.8" y2="19.8" />
            <line x1="2" y1="12" x2="4.5" y2="12" />
            <line x1="19.5" y1="12" x2="22" y2="12" />
            <line x1="4.2" y1="19.8" x2="6" y2="18" />
            <line x1="18" y1="6" x2="19.8" y2="4.2" />
          </svg>
          <svg id="icon-moon" class="hidden dark:block" width="14" height="14" viewBox="0 0 24 24" fill="#64748b" stroke="none">
            <path d="M20.5 14.5a8.5 8.5 0 1 1-9-13 7 7 0 0 0 9 9c0 1.4 0 3.3 0 4z" />
          </svg>
        </span>
      </button>

      <!-- Botão menu mobile -->
      <button
        id="mobile-menu-btn"
        aria-controls="mobile-menu"
        aria-expanded="false"
        class="lg:hidden p-2 rounded-lg text-muted hover:text-foreground hover:bg-foreground/5 transition-colors"
        aria-label="Abrir menu"
      >
        <svg id="icon-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
        <svg id="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Painel de busca do menu: produtos (foto, nome e preço) e guias -->
  <div id="busca-pop" class="busca-pop" hidden>
    <div class="max-w-6xl mx-auto px-4 flex justify-end">
      <div class="busca-pop__painel" role="dialog" aria-label="Buscar no site">
        <form class="busca-pop__form" action="/busca/" method="get" role="search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
          <label for="busca-pop-input" class="sr-only">Buscar produtos e guias</label>
          <input
            id="busca-pop-input"
            type="search"
            name="q"
            placeholder="Buscar produto, marca ou guia..."
            autocomplete="off"
            enterkeyhint="search"
            aria-controls="busca-pop-res"
          />
          <button type="button" class="busca-pop__fechar" data-busca-fechar aria-label="Fechar busca">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </form>
        <div id="busca-pop-res" class="busca-pop__res" aria-live="polite">
          <p class="bp-dica">Digite o nome de um produto, uma marca ou um assunto.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Menu mobile -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-border"
    role="dialog"
    aria-label="Navegação mobile"
  >
    <ul class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1" role="list">
      <li>
        <a
          href="/"
          aria-current={currentPath === '/' ? 'page' : undefined}
          class={`block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors ${
            currentPath === '/' ? 'text-brand bg-brand/10' : 'text-muted hover:text-foreground hover:bg-foreground/5'
          }`}
        >
          Início
        </a>
      </li>

      <li>
        <a href="/black-friday/" class="bf-btn bf-btn--linha">
          <svg class="bf-btn__ico" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c.6 3.2-1 5.1-2.6 6.9C7.8 10.7 6 12.6 6 15.5A6 6 0 0 0 18 15.5c0-2.3-1-4.1-2.2-5.4-.3 1.6-1.1 2.7-2.3 3.2.4-3.6-.4-7.6-1.5-11.3z"/></svg>
          <span>Black Friday: ofertas de hoje</span>
        </a>
      </li>

      <li>
        <div
          class={`flex items-center rounded-lg transition-colors ${
            isAnalisesActive ? 'text-brand bg-brand/10' : 'text-muted hover:text-foreground hover:bg-foreground/5'
          }`}
        >
          <a
            href="/blog/"
            aria-current={isAnalisesActive ? 'page' : undefined}
            class="flex-1 block pl-4 pr-2 py-2.5 text-sm font-medium"
          >
            Análises
          </a>
          <button
            id="mobile-analises-btn"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-analises-submenu"
            aria-label="Ver categorias de análises"
            class="pr-3 py-2.5"
          >
            <svg id="mobile-analises-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </div>
        <ul id="mobile-analises-submenu" class="hidden mt-1 ml-3 flex flex-col gap-0.5 border-l border-border pl-3" role="list">
          {analiseCategorias.map((cat) => (
            <li>
              <a
                href={`/categoria/${slugifyCategory(cat)}/`}
                class="block px-3 py-1.5 rounded-lg text-sm text-muted hover:text-foreground hover:bg-foreground/5 transition-colors"
              >
                {cat}
              </a>
            </li>
          ))}
        </ul>
      </li>

      <li>
        <div
          class={`flex items-center rounded-lg transition-colors ${
            isFerramentasActive ? 'text-brand bg-brand/10' : 'text-muted hover:text-foreground hover:bg-foreground/5'
          }`}
        >
          <span class="flex-1 pl-4 pr-2 py-2.5 text-sm font-medium">Ferramentas</span>
          <button
            id="mobile-ferramentas-btn"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-ferramentas-submenu"
            aria-label="Ver ferramentas"
            class="pr-3 py-2.5"
          >
            <svg id="mobile-ferramentas-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </button>
        </div>
        <ul id="mobile-ferramentas-submenu" class="hidden mt-1 ml-3 flex flex-col gap-0.5 border-l border-border pl-3" role="list">
          {ferramentas.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={currentPath.startsWith(href) ? 'page' : undefined}
                class="block px-3 py-1.5 rounded-lg text-sm text-muted hover:text-foreground hover:bg-foreground/5 transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </li>

      {navLinks.filter(({ href }) => href !== '/').map(({ href, label }) => {
        const isActive = currentPath.startsWith(href);
        return (
          <li>
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              class={`block px-4 py-2.5 rounded-lg text-sm font-medium transition-colors ${
                isActive
                  ? 'text-brand bg-brand/10'
                  : 'text-muted hover:text-foreground hover:bg-foreground/5'
              }`}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<style is:global>
  /* Botão da Black Friday no menu: fundo escuro, chama amarela e borda de luz girando. */
  @property --bf-ang {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }
  .bf-btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 13px;
    border-radius: 999px;
    background: #141416;
    color: #fff !important;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-decoration: none !important;
    box-shadow: 0 0 18px rgba(230, 57, 70, 0.35);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .bf-btn::before {
    content: '';
    position: absolute;
    inset: -2px;
    z-index: -1;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(from var(--bf-ang), #e63946, #fde047, #f97316, #e63946);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: bf-gira 2.6s linear infinite;
  }
  .bf-btn:hover,
  .bf-btn.is-on { transform: translateY(-1px); box-shadow: 0 0 26px rgba(253, 224, 71, 0.4); }
  .bf-btn__ico { color: #fde047; animation: bf-chama 1.4s ease-in-out infinite alternate; transform-origin: 50% 90%; }
  .bf-btn--compacto { padding: 6px 10px; font-size: 12px; }
  /* O CSS global ganha das utilidades do Tailwind (lg:hidden), então o sumiço no desktop fica aqui. */
  @media (min-width: 1024px) { .bf-btn--compacto { display: none; } }
  /* Celular estreito: só a chama, para não encostar no logo. */
  @media (max-width: 420px) {
    .bf-btn--compacto { padding: 6px; }
    .bf-btn--compacto span { display: none; }
    nav > div:has(> .bf-btn--compacto) { gap: 2px; }
  }
  .bf-btn--linha { display: flex; justify-content: center; margin: 4px 0; padding: 10px 14px; font-size: 14px; }
  @keyframes bf-gira { to { --bf-ang: 360deg; } }
  @keyframes bf-chama { from { transform: scale(0.9) rotate(-6deg); } to { transform: scale(1.12) rotate(5deg); } }
  @media (prefers-reduced-motion: reduce) {
    .bf-btn::before,
    .bf-btn__ico { animation: none; }
  }
</style>

<script>
  const btn = document.getElementById('mobile-menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  const iconMenu = document.getElementById('icon-menu')!;
  const iconClose = document.getElementById('icon-close')!;

  btn.addEventListener('click', () => {
    const isOpen = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
    iconMenu.classList.toggle('hidden', isOpen);
    iconClose.classList.toggle('hidden', !isOpen);
  });

  const themeToggle = document.getElementById('theme-toggle')!;
  const themeColorMeta = document.querySelector('meta[name="theme-color"]');

  themeToggle.setAttribute('aria-checked', String(document.documentElement.classList.contains('dark')));

  themeToggle.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    themeToggle.setAttribute('aria-checked', String(isDark));
    themeColorMeta?.setAttribute('content', isDark ? '#0a0a0a' : '#ffffff');
  });

  // Dropdowns de desktop ("Análises" e "Ferramentas"), mesma mecânica
  const hoverCapable = window.matchMedia('(hover: hover)').matches;

  function wireDropdown(itemId: string, btnId: string, ddId: string, iconId: string) {
    const item = document.getElementById(itemId);
    const button = document.getElementById(btnId);
    const dd = document.getElementById(ddId);
    const icon = document.getElementById(iconId);
    if (!item || !button || !dd) return;
    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    const open = () => {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      dd.classList.remove('hidden');
      button.setAttribute('aria-expanded', 'true');
      icon?.classList.add('rotate-180');
    };
    const close = () => {
      dd.classList.add('hidden');
      button.setAttribute('aria-expanded', 'false');
      icon?.classList.remove('rotate-180');
    };

    button.addEventListener('click', (e) => {
      e.stopPropagation();
      dd.classList.contains('hidden') ? open() : close();
    });

    if (hoverCapable) {
      item.addEventListener('mouseenter', open);
      item.addEventListener('mouseleave', () => { closeTimer = setTimeout(close, 150); });
    }

    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!dd.contains(t) && !button.contains(t)) close();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }

  wireDropdown('analises-menu-item', 'analises-dropdown-btn', 'analises-dropdown', 'analises-dropdown-icon');
  wireDropdown('ferramentas-menu-item', 'ferramentas-dropdown-btn', 'ferramentas-dropdown', 'ferramentas-dropdown-icon');

  // Accordions do menu mobile ("Análises" e "Ferramentas")
  function wireAccordion(btnId: string, submenuId: string, iconId: string) {
    const button = document.getElementById(btnId);
    const submenu = document.getElementById(submenuId);
    const icon = document.getElementById(iconId);
    if (!button || !submenu) return;
    button.addEventListener('click', () => {
      const isOpen = submenu.classList.toggle('hidden') === false;
      button.setAttribute('aria-expanded', String(isOpen));
      icon?.classList.toggle('rotate-180', isOpen);
    });
  }

  wireAccordion('mobile-analises-btn', 'mobile-analises-submenu', 'mobile-analises-icon');
  wireAccordion('mobile-ferramentas-btn', 'mobile-ferramentas-submenu', 'mobile-ferramentas-icon');
</script>

<script>
  // Painel de busca do menu: abre no clique da lupa (sem JS, a lupa leva para /busca/).
  import { buscarGuias, buscarProdutos, carregarPagefind, carregarProdutos, htmlGuias, htmlProdutos } from '../scripts/busca';

  const lupa = document.getElementById('busca-btn') as HTMLAnchorElement | null;
  const pop = document.getElementById('busca-pop');
  const input = document.getElementById('busca-pop-input') as HTMLInputElement | null;
  const res = document.getElementById('busca-pop-res');

  if (lupa && pop && input && res) {
    const DICA = res.innerHTML;
    let seq = 0;
    let timerGuias: ReturnType<typeof setTimeout> | undefined;

    const abrir = () => {
      pop.hidden = false;
      lupa.setAttribute('aria-expanded', 'true');
      input.focus();
      input.select();
      carregarProdutos();
      carregarPagefind();
    };
    const fechar = (devolverFoco = false) => {
      pop.hidden = true;
      lupa.setAttribute('aria-expanded', 'false');
      if (devolverFoco) lupa.focus();
    };

    const todos = (q: string) =>
      `<a class="bp-todos" href="/busca/?q=${encodeURIComponent(q)}">Ver todos os resultados para “${q.replace(/[&<>"]/g, '')}” →</a>`;

    const render = (q: string, prods: string, guias: string | null) => {
      let h = '';
      if (prods) h += `<p class="bp-sec">Produtos</p>${prods}`;
      if (guias === null) h += '<p class="bp-sec">Guias e análises</p><p class="bp-dica">Buscando…</p>';
      else if (guias) h += `<p class="bp-sec">Guias e análises</p>${guias}`;
      if (!prods && guias === '') h = `<p class="bp-dica">Nada encontrado para “${q.replace(/[&<>"]/g, '')}”. Tente outra palavra.</p>`;
      res.innerHTML = h + todos(q);
    };

    const atualizar = async () => {
      const q = input.value.trim();
      const minha = ++seq;
      clearTimeout(timerGuias);
      if (q.length < 2) {
        res.innerHTML = DICA;
        return;
      }
      const lista = buscarProdutos(await carregarProdutos(), q, 5);
      if (minha !== seq) return;
      const prods = lista.length ? htmlProdutos(lista) : '';
      render(q, prods, null);
      timerGuias = setTimeout(async () => {
        const guias = await buscarGuias(q, 4);
        if (minha !== seq) return;
        render(q, prods, guias.length ? htmlGuias(guias) : '');
      }, 150);
    };

    lupa.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      if (pop.hidden) abrir();
      else fechar();
    });
    input.addEventListener('input', atualizar);
    pop.querySelector('[data-busca-fechar]')?.addEventListener('click', () => fechar(true));

    // Setas navegam pelos resultados; Esc fecha; "/" abre de qualquer lugar.
    pop.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        fechar(true);
        return;
      }
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
      const links = [...res.querySelectorAll<HTMLAnchorElement>('a')];
      if (!links.length) return;
      e.preventDefault();
      const i = links.indexOf(document.activeElement as HTMLAnchorElement);
      if (e.key === 'ArrowDown') links[i < 0 ? 0 : Math.min(i + 1, links.length - 1)].focus();
      else if (i <= 0) input.focus();
      else links[i - 1].focus();
    });
    document.addEventListener('keydown', (e) => {
      const alvo = e.target as HTMLElement;
      const digitando = alvo.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(alvo.tagName);
      if (e.key === '/' && !digitando && pop.hidden) {
        e.preventDefault();
        abrir();
      }
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!pop.hidden && !pop.contains(t) && !lupa.contains(t)) fechar();
    });
  }
</script>
