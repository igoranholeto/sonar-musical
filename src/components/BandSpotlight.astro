---
import { getCollection } from 'astro:content';
import { generoAccent, generoGradient, generoSoft, iniciais } from '../utils/generos';

// Spotlight de bandas na home: shelf horizontal com snap. Progressive
// enhancement puro — cada card é um <a> real (crawlável, ótimo p/ interlinking
// interno). Prioriza bandas com foto de capa pra vitrine visual mais forte.
const todas = await getCollection('bandas');
const comFoto = todas.filter((b) => b.data.fotoCapa);
const semFoto = todas.filter((b) => !b.data.fotoCapa);
const bandas = [...comFoto, ...semFoto].slice(0, 10);
---

<section class="py-16 max-w-6xl mx-auto px-4">
  <div class="flex items-center justify-between mb-8">
    <div>
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand mb-1">
        <span class="w-1.5 h-1.5 bg-brand rounded-full" aria-hidden="true"></span>
        Setup de quem inspira
      </span>
      <h2 class="text-2xl font-bold">Bandas em Destaque</h2>
    </div>
    <a href="/bandas/" class="text-sm text-brand font-medium hover:underline underline-offset-2 whitespace-nowrap">
      Ver todas →
    </a>
  </div>

  <div class="spotlight">
    <div class="spotlight__track">
      {bandas.map((banda) => {
        const { nome, genero, origem, ano, fotoCapa, fotoCapaAlt } = banda.data;
        const accent = generoAccent(genero);
        const gradient = generoGradient(genero);
        const tagBg = generoSoft(genero);
        return (
          <a
            href={`/bandas/${banda.id}/`}
            class="spotlight__card"
            style={`--accent:${accent}`}
            aria-label={`Ver banda ${nome}`}
          >
            <div class="spotlight__art" style={`background:${gradient}`}>
              {fotoCapa ? (
                <img
                  src={fotoCapa}
                  alt={fotoCapaAlt ?? nome}
                  width="260"
                  height="160"
                  loading="lazy"
                  decoding="async"
                  class="spotlight__img"
                />
              ) : (
                <span class="spotlight__iniciais">{iniciais(nome)}</span>
              )}
              <span class="spotlight__genero" style={`background:${tagBg};color:${accent}`}>{genero}</span>
            </div>
            <div class="spotlight__body">
              <h3 class="spotlight__nome">{nome}</h3>
              <div class="spotlight__meta">{origem} · {ano}</div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .spotlight {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scroll-snap-type: x proximity;
    margin: 0 -1rem;
    padding: 0.25rem 1rem 0.75rem;
  }
  .spotlight__track {
    display: flex;
    gap: 1rem;
    width: max-content;
  }
  .spotlight__card {
    flex: 0 0 260px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .spotlight__card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35);
  }
  .spotlight__art {
    position: relative;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .spotlight__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .spotlight__iniciais {
    font-size: 2rem;
    font-weight: 900;
    color: rgba(255, 255, 255, 0.85);
  }
  .spotlight__genero {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }
  .spotlight__body {
    padding: 0.9rem 1rem 1.1rem;
  }
  .spotlight__nome {
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }
  .spotlight__meta {
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-top: 0.2rem;
  }
</style>
