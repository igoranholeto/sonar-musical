    border-radius: 50%;
    flex-shrink: 0;
  }

  .tip-dot--green  { background: #22c55e; }
  .tip-dot--yellow { background: #facc15; }
  .tip-dot--red    { background: #e63946; }

  /* ── Mobile tweaks ───────────────────────────────────────── */
  @media (max-width: 400px) {
    .note-name { font-size: 4rem; }
    .tuner-display { padding: 1.25rem 1rem 1rem; }
