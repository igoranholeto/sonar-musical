  /* ── Conteúdo SEO ────────────────────────────────────────── */
  .tuner-content {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .tuner-content h2 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 2rem 0 0.75rem;
    color: var(--color-foreground);
  }

  .tuner-content h2:first-child { margin-top: 0; }

  .tuner-content p {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .tuner-content ol {
    margin: 0 0 1rem;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .tuner-content ol li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .tuner-content a {
    color: var(--color-brand);
    text-decoration: none;
  }

  .tuner-content a:hover { text-decoration: underline; }

  /* ── FAQ ─────────────────────────────────────────────────── */
  .tuner-faq { margin-top: 2.5rem; }

  .tuner-faq__item {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 0.9rem 1.1rem;
    margin-bottom: 0.6rem;
    background: var(--color-card);
  }

  .tuner-faq__item summary {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-foreground);
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: 1.5rem;
  }

  .tuner-faq__item summary::-webkit-details-marker { display: none; }

  .tuner-faq__item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: -0.1rem;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-brand);
    transition: transform 0.2s;
  }

  .tuner-faq__item[open] summary::after {
    transform: rotate(45deg);
  }

  .tuner-faq__item p {
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--color-muted);
    margin: 0.75rem 0 0;
  }
</style>

<script>
// Afinador reescrito em nov/2026. O que mudou e por quê:
// - Detecção (McLeod/NSDF) em duas etapas: busca grossa num sinal reduzido a
//   ~11 kHz e refino na taxa cheia só em volta do período achado. A versão
//   anterior fazia a conta inteira a 44 kHz em todo quadro (pesado no celular)
//   e deixava o lóbulo do atraso zero virar "pico" (leituras agudas falsas).
// - Uma suavização só (mediana de 3 + média móvel rápida). Antes eram três em
//   série, e a cor, os cents e o "Afinado" vinham da agulha atrasada.
// - Os cents são medidos contra a CORDA da afinação, não contra o semitom mais
//   perto: uma 3ª da viola em Sol no Cebolão (Fá#) agora aparece 1 semitom
//   acima, e não "afinada em Sol".
// - Pares oitavados da viola: a corda fina do 5º, 4º e 3º par é reconhecida
//   como parte do mesmo par (antes ia para o 2º par).
// - Tocar numa corda toca a nota de referência e trava o afinador nela.

type Afinacao = { label: string; strings: string[]; oitavas?: boolean[] };
// Viola: nos 3 pares graves (5º, 4º, 3º) uma das cordas é uma oitava acima.
const OIT_VIOLA = [true, true, true, false, false];
const TUNINGS: Record<string, Afinacao[]> = {
  guitarra: [
    { label: 'Standard (E)',   strings: ['E2','A2','D3','G3','B3','E4'] },
    { label: 'Drop D',         strings: ['D2','A2','D3','G3','B3','E4'] },
    { label: 'Drop C',         strings: ['C2','G2','C3','F3','A3','D4'] },
    { label: 'Open G',         strings: ['D2','G2','D3','G3','B3','D4'] },
    { label: 'Open E',         strings: ['E2','B2','E3','G#3','B3','E4'] },
    { label: 'DADGAD',         strings: ['D2','A2','D3','G3','A3','D4'] },
    { label: 'Half Step Down', strings: ['Eb2','Ab2','Db3','Gb3','Bb3','Eb4'] },
    { label: 'Full Step Down', strings: ['D2','G2','C3','F3','A3','D4'] },
