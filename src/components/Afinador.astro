    { label: 'Drop D',         strings: ['D2','A2','D3','G3','B3','E4'] },
    { label: 'Open G',         strings: ['D2','G2','D3','G3','B3','D4'] },
    { label: 'Nashville',      strings: ['E3','A3','D4','G4','B3','E4'] },
    { label: 'Open D',         strings: ['D2','A2','D3','F#3','A3','D4'] },
    { label: 'Half Step Down', strings: ['Eb2','Ab2','Db3','Gb3','Bb3','Eb4'] },
    { label: 'DADGAD',         strings: ['D2','A2','D3','G3','A3','D4'] },
  ],
};
const COM_PARES = new Set(['viola', 'bandolim']);

const NOTE_NAMES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];
const ENHARMONICS: Record<string, string> = { Db:'C#', Eb:'D#', Fb:'E', Gb:'F#', Ab:'G#', Bb:'A#', Cb:'B' };
const SOLFEJO: Record<string, string> = {
  C:'Dó', 'C#':'Dó#', Db:'Ré♭', D:'Ré', 'D#':'Ré#', Eb:'Mi♭', E:'Mi', F:'Fá', 'F#':'Fá#',
  Gb:'Sol♭', G:'Sol', 'G#':'Sol#', Ab:'Lá♭', A:'Lá', 'A#':'Lá#', Bb:'Si♭', B:'Si',
};

const letra = (nota: string) => nota.replace(/\d+$/, '');
function noteToMidi(note: string): number {
  const n = ENHARMONICS[letra(note)] ?? letra(note);
  return (parseInt(note.replace(/\D/g, ''), 10) + 1) * 12 + NOTE_NAMES.indexOf(n);
}
const midiToFreq = (m: number) => 440 * Math.pow(2, (m - 69) / 12);

// ─── DOM ──────────────────────────────────────────────────────────────────────
const $ = (id: string) => document.getElementById(id)!;
const micBtn = $('mic-btn'), micLabel = $('mic-label'), micStatus = $('mic-status');
const noteName = $('note-name'), noteOctave = $('note-octave'), centsPill = $('cents-pill');
const freqDisplay = $('freq-display'), needle = $('needle'), needlePivot = $('needle-pivot');
const arcGreen = $('arc-green'), tunerDisplay = $('tuner-display'), inTuneBadge = $('in-tune-badge');
const directionHint = $('direction-hint'), stringsDisplay = $('strings-display');
const stringsHint = $('strings-hint'), targetLine = $('target-line'), levelBar = $('level-bar');
const tuningSelect = $('tuning-select') as HTMLSelectElement;

// ─── Estado ───────────────────────────────────────────────────────────────────
let instrument = ($('tuner-root') as HTMLElement).dataset.instrument ?? 'guitarra';
let tuningIdx = 0;
let travada = -1;                 // índice da corda travada (-1 = automático)
const feitas = new Set<number>(); // cordas que já chegaram ao centro
let cards: HTMLButtonElement[] = [];

let isListening = false;
let audioCtx: AudioContext | null = null;
let outCtx: AudioContext | null = null;  // só para a nota de referência sem microfone
let analyser: AnalyserNode | null = null;
let micStream: MediaStream | null = null;
let rafId: number | null = null;
let buf: Float32Array = new Float32Array(0);
let dec: Float32Array = new Float32Array(0);
let wakeLock: any = null;

const afinacao = () => TUNINGS[instrument][tuningIdx];
const pares = () => COM_PARES.has(instrument);

// ─── Afinações e cordas ───────────────────────────────────────────────────────
function renderTunings() {
  tuningSelect.innerHTML = '';
  TUNINGS[instrument].forEach((t, i) => {
    const opt = document.createElement('option');
    opt.value = String(i);
    opt.textContent = `${t.label}, ${t.strings.map(letra).join(' ')}`;
    if (i === tuningIdx) opt.selected = true;
    tuningSelect.appendChild(opt);
  });
}

function nomeCorda(i: number) {
  const n = afinacao().strings.length - i;
  return pares() ? `${n}º par` : `${n}ª corda`;
}

function renderStrings() {
  const t = afinacao();
  stringsDisplay.innerHTML = '';
  stringsDisplay.style.setProperty('--cordas', String(t.strings.length));
  cards = t.strings.map((s, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'string-card';
    b.setAttribute('aria-pressed', 'false');
    b.setAttribute('aria-label', `${nomeCorda(i)}, ${SOLFEJO[letra(s)] ?? letra(s)}: ouvir a nota e travar`);
    b.innerHTML = `<span class="string-num">${nomeCorda(i)}</span><span class="string-note">${letra(s)}</span><span class="string-full">${SOLFEJO[letra(s)] ?? ''}</span>`;
    b.addEventListener('click', () => clicarCorda(i));
    stringsDisplay.appendChild(b);
    return b;
  });
  atualizarCards(-1, false);
}

let cardsAtivo = -2, cardsAfinado = false;
function atualizarCards(ativo: number, afinado: boolean, forcar = false) {
  if (!forcar && ativo === cardsAtivo && afinado === cardsAfinado) return;
  cardsAtivo = ativo; cardsAfinado = afinado;
  cards.forEach((c, i) => {
    c.classList.toggle('active', i === ativo && !afinado);
    c.classList.toggle('in-tune', i === ativo && afinado);
    c.classList.toggle('locked', i === travada);
    c.classList.toggle('done', feitas.has(i));
    c.setAttribute('aria-pressed', i === travada ? 'true' : 'false');
  });
}

function textoAlvoParado() {
  if (travada >= 0) {
    const s = afinacao().strings[travada];
    return `Travado no <strong>${nomeCorda(travada)}</strong> (${SOLFEJO[letra(s)]}). Toque essa corda.`;
  }
  return isListening ? 'Toque uma corda' : 'Ative o microfone e toque uma corda';
}

function reiniciarAfinacao() {
  travada = -1;
  feitas.clear();
  alvoAtual = null;
  renderStrings();
  resetDisplay();
  stringsHint.textContent = 'Toque numa corda para ouvir a nota certa e travar o afinador nela.';
}

tuningSelect.addEventListener('change', () => {
  tuningIdx = parseInt(tuningSelect.value, 10);
  reiniciarAfinacao();
});

document.querySelectorAll<HTMLElement>('.tab-btn').forEach((btn) => {
  btn.addEventListener('click', () => {
    instrument = btn.dataset.instrument!;
    tuningIdx = 0;
    document.querySelectorAll('.tab-btn').forEach((b) => b.classList.toggle('tab-btn--active', b === btn));
    renderTunings();
    reiniciarAfinacao();
  });
});

// ─── Nota de referência (síntese aditiva: altura exata, timbre de corda) ─────
const cacheRef = new Map<string, AudioBuffer>();
let ignorarAte = 0;
function bufferReferencia(ctx: AudioContext, midi: number): AudioBuffer {
  const chave = `${ctx.sampleRate}:${midi}`;
  const pronto = cacheRef.get(chave);
  if (pronto) return pronto;
  const sr = ctx.sampleRate, dur = 2, len = Math.floor(sr * dur);
  const b = ctx.createBuffer(1, len, sr);
  const d = b.getChannelData(0);
  const f = midiToFreq(midi);
  const H = Math.max(1, Math.min(10, Math.floor(5000 / f)));
  for (let h = 1; h <= H; h++) {
    const amp = 1 / Math.pow(h, 1.1);
    const tau = 0.9 / (1 + 0.45 * (h - 1));   // harmônicos agudos somem antes
    const w = 2 * Math.PI * f * h / sr;
    for (let n = 0; n < len; n++) d[n] += amp * Math.exp(-n / (sr * tau)) * Math.sin(w * n);
  }
  let pico = 0;
  for (let n = 0; n < len; n++) pico = Math.max(pico, Math.abs(d[n]));
  const ataque = Math.floor(sr * 0.004);
  for (let n = 0; n < len; n++) d[n] = (d[n] / pico) * 0.5 * (n < ataque ? n / ataque : 1);
  cacheRef.set(chave, b);
  return b;
}

function tocarReferencia(midi: number) {
  try {
    let ctx = audioCtx;
    if (!ctx) {
      try { if ((navigator as any).audioSession) (navigator as any).audioSession.type = 'playback'; } catch (_) {}
      outCtx = outCtx ?? new ((window.AudioContext || (window as any).webkitAudioContext) as typeof AudioContext)();
      ctx = outCtx;
    }
    if (ctx.state === 'suspended') ctx.resume();
    const src = ctx.createBufferSource();
    src.buffer = bufferReferencia(ctx, midi);
    src.connect(ctx.destination);
    src.start();
    ignorarAte = performance.now() + 1300; // o microfone ouviria a própria referência
  } catch (_) { /* sem áudio: segue só com o travamento */ }
}

function clicarCorda(i: number) {
  if (travada === i) {
    travada = -1;
    stringsHint.textContent = 'Modo automático: toque qualquer corda.';
  } else {
    travada = i;
    alvoAtual = null;
    tocarReferencia(noteToMidi(afinacao().strings[i]));
    (window as any).gtag?.('event', 'tool_use', { ferramenta: 'afinador', acao: 'referencia', instrumento: instrument });
    stringsHint.textContent = `Travado no ${nomeCorda(i)}. Toque de novo para ouvir; toque no destacado para voltar ao automático.`;
  }
  atualizarCards(cardsAtivo, cardsAfinado, true);
  if (!temLeitura) targetLine.innerHTML = textoAlvoParado();
}

// ─── Detecção: McLeod (NSDF) em duas etapas ──────────────────────────────────
function nsdf(x: Float32Array, W: number, tau: number, o = 0): number {
  let r = 0, e = 0;
  for (let i = o; i < o + W; i++) {
    const a = x[i], b = x[i + tau];
    r += a * b; e += a * a + b * b;
  }
  return e > 0 ? (2 * r) / e : 0;
}

let pisoRuido = 0.002;
function detectar(sr: number): { f: number; clareza: number; rms: number } {
  const N = buf.length;
  let media = 0;
  for (let i = 0; i < N; i++) media += buf[i];
  media /= N;
  let rms = 0;
  for (let i = 0; i < N; i++) { buf[i] -= media; rms += buf[i] * buf[i]; }
  rms = Math.sqrt(rms / N);
  const portao = Math.max(0.0035, pisoRuido * 2.5);
  if (rms < portao) {
    pisoRuido = pisoRuido * 0.97 + rms * 0.03;
    return { f: -1, clareza: 0, rms };
  }

  // 1) Reduz para ~11 kHz (média de D amostras + suavização 1-2-1).
  const D = Math.max(1, Math.floor(sr / 11000));
  const M = Math.floor(N / D);
  for (let i = 0; i < M; i++) {
    let s = 0;
    for (let k = 0; k < D; k++) s += buf[i * D + k];
    dec[i] = s / D;
  }
  for (let i = M - 2; i >= 1; i--) dec[i] = 0.25 * dec[i - 1] + 0.5 * dec[i] + 0.25 * dec[i + 1];
  const srD = sr / D;
  const W = Math.floor(M / 2);
  const tMin = Math.max(2, Math.floor(srD / 1400));
  const tMax = Math.min(M - W - 2, Math.ceil(srD / 50));

  // 2) Picos dos lóbulos positivos DEPOIS do primeiro cruzamento negativo
  //    (o lóbulo do atraso zero não é período).
  let cruzou = false;
  let lobMax = -1, lobLag = -1;
  const picos: Array<[number, number]> = [];
  for (let t = 1; t <= tMax; t++) {
    const v = nsdf(dec, W, t);
    if (!cruzou) { if (v <= 0) cruzou = true; continue; }
    if (v > 0) {
      if (v > lobMax) { lobMax = v; lobLag = t; }
    } else if (lobLag > 0) {
      picos.push([lobLag, lobMax]);
      lobMax = -1; lobLag = -1;
    }
  }
  if (lobLag > 0) picos.push([lobLag, lobMax]);
  const validos = picos.filter(([t]) => t >= tMin);
  if (!validos.length) return { f: -1, clareza: 0, rms };
  const maior = validos.reduce((m, p) => Math.max(m, p[1]), 0);
  const escolhido = validos.find((p) => p[1] >= 0.9 * maior)!;
  if (escolhido[1] < 0.6) return { f: -1, clareza: escolhido[1], rms };

  // 3) Refino na taxa cheia, só em volta do período achado. Antes, um
  //    passa-baixa de 2 polos em ~2,5x a fundamental: os harmônicos agudos de
  //    corda real são um pouco "esticados" (inarmonicidade) e puxariam a
  //    leitura alguns cents para cima.
  const fc = Math.min(sr / 4, 2.5 * (srD / escolhido[0]));
  const k = 1 - Math.exp((-2 * Math.PI * fc) / sr);
  let y1 = 0, y2 = 0;
  for (let i = 0; i < N; i++) { y1 += k * (buf[i] - y1); y2 += k * (y1 - y2); buf[i] = y2; }
  // O começo do sinal filtrado tem o transiente do filtro: fica de fora.
  const O = Math.min(Math.ceil((3 * sr) / fc), Math.floor(N / 8));
  const WF = Math.floor(N / 2);
  const c = escolhido[0] * D;
  let melhor = c, vMelhor = -2;
  const ini = Math.max(2, c - D - 1), fim = Math.min(N - O - WF - 2, c + D + 1);
  for (let t = ini; t <= fim; t++) {
    const v = nsdf(buf, WF, t, O);
    if (v > vMelhor) { vMelhor = v; melhor = t; }
  }
  const a = nsdf(buf, WF, melhor - 1, O), b = nsdf(buf, WF, melhor + 1, O);
  const den = a - 2 * vMelhor + b;
  const ajuste = den !== 0 ? (0.5 * (a - b)) / den : 0;
  const periodo = melhor + Math.max(-0.5, Math.min(0.5, ajuste));
  return { f: sr / periodo, clareza: vMelhor, rms };
}

// ─── Leitura suavizada (em semitons MIDI) ────────────────────────────────────
const ultimas: number[] = [];
let suave = 0;
let temLeitura = false;
let saltos = 0;
let ultimaValida = 0;

function registrar(m: number, agora: number) {
  if (agora - ultimaValida > 250) ultimas.length = 0;
  ultimaValida = agora;
  ultimas.push(m);
  if (ultimas.length > 3) ultimas.shift();
  const med = ultimas.slice().sort((x, y) => x - y)[Math.floor(ultimas.length / 2)];
  if (!temLeitura) { suave = med; temLeitura = true; saltos = 0; return; }
  if (Math.abs(med - suave) > 0.6) {
    // Nota nova: confirma em 2 quadros para não piscar com o ataque da palheta.
    if (++saltos >= 2) { suave = med; saltos = 0; ultimas.length = 0; ultimas.push(med); }
    return;
  }
  saltos = 0;
  suave += (med - suave) * 0.3;
}

// ─── Corda alvo ──────────────────────────────────────────────────────────────
type Alvo = { idx: number; midi: number; oitava: boolean; tambem?: number };
let alvoAtual: Alvo | null = null;
function escolherAlvo(m: number): Alvo | null {
  const t = afinacao();
  if (travada >= 0) {
    const base = noteToMidi(t.strings[travada]);
    const k = Math.round((m - base) / 12);
    return { idx: travada, midi: base + 12 * k, oitava: k !== 0 };
  }
  const cands: Alvo[] = [];
  t.strings.forEach((s, i) => {
    const base = noteToMidi(s);
    cands.push({ idx: i, midi: base, oitava: false });
    if (t.oitavas?.[i]) cands.push({ idx: i, midi: base + 12, oitava: true });
  });
  // Empate de nota (ex.: Lá3 é o 2º par e também a corda fina do 5º no
  // Cebolão em Ré): prefere o par principal e avisa da outra corda.
  const dist = (c: Alvo) => Math.abs(m - c.midi) + (c.oitava ? 0.01 : 0);
  let melhor = cands[0];
  for (const c of cands) if (dist(c) < dist(melhor)) melhor = c;
  const gemea = cands.find((c) => c !== melhor && c.midi === melhor.midi);
  if (gemea) melhor = { ...melhor, tambem: gemea.idx };
  if (Math.abs(m - melhor.midi) > 2.6) return null;
  // Histerese: não troca de corda por pouco (evita pular entre pares vizinhos).
  if (alvoAtual && alvoAtual.midi !== melhor.midi && Math.abs(m - alvoAtual.midi) <= Math.abs(m - melhor.midi) + 0.35 && Math.abs(m - alvoAtual.midi) <= 2.6) {
    return alvoAtual;
  }
  return melhor;
}

// ─── Visor ───────────────────────────────────────────────────────────────────
let anguloAtual = 0, anguloAlvo = 0;
function desenharAgulha() {
  anguloAtual += (anguloAlvo - anguloAtual) * 0.35;
  needle.setAttribute('transform', `rotate(${anguloAtual.toFixed(2)} 150 140)`);
}
function corPara(abs: number) { return abs <= 5 ? '#22c55e' : abs <= 20 ? '#facc15' : '#e63946'; }

let ultimoPill = '', ultimaDica = '', ultimaCor = '';
function setPill(c: number | null) {
  let txt: string, cls: string;
  if (c === null) { txt = '· · ·'; cls = 'idle'; }
  else {
    const abs = Math.abs(c), sinal = c >= 0 ? '+' : '−';
    if (Math.round(abs) === 0) txt = '0¢';
    else if (abs < 100) txt = `${sinal}${Math.round(abs)}¢`;
    else {
      const st = Math.round(abs / 10) / 10;
      txt = `${sinal}${String(st).replace('.', ',')} ${st >= 2 ? 'semitons' : 'semitom'}`;
    }
    cls = abs <= 5 ? 'green' : abs <= 20 ? 'yellow' : 'red';
  }
  const chave = txt + cls;
  if (chave === ultimoPill) return;
  ultimoPill = chave;
  centsPill.textContent = txt;
  centsPill.className = `cents-pill cents-pill--${cls}`;
}

function setDica(c: number | null, afinado: boolean) {
  let cls = 'hidden', html = '';
  if (c !== null) {
    const abs = Math.abs(c);
    if (afinado) { cls = 'ok'; html = '✓ Afinado. Pode ir para a próxima corda.'; }
    else if (abs > 5) {
      const leve = abs <= 20;
      cls = c < 0 ? (leve ? 'low' : 'red-low') : (leve ? 'high' : 'red-high');
      html = c < 0
        ? `<span>↑</span> ${leve ? 'Quase: aperte de leve' : 'Grave: aperte a cravelha'}`
        : `<span>↓</span> ${leve ? 'Quase: afrouxe de leve' : 'Aguda: afrouxe a cravelha'}`;
    }
  }
  const chave = cls + html;
  if (chave === ultimaDica) return;
  ultimaDica = chave;
  directionHint.className = `direction-hint direction-hint--${cls}`;
  directionHint.innerHTML = html;
}

function setCor(cor: string) {
  if (cor === ultimaCor) return;
  ultimaCor = cor;
  needle.setAttribute('stroke', cor);
  needlePivot.setAttribute('fill', cor);
}

let afinadoDesde = 0, afinado = false;
function setInTune(on: boolean) {
  if (on === afinado) return;
  afinado = on;
  tunerDisplay.classList.toggle('in-tune-state', on);
  inTuneBadge.classList.toggle('visible', on);
  arcGreen.setAttribute('opacity', on ? '0.7' : '0.3');
}

function playTuneSound(ctx: AudioContext) {
  try {
    const osc = ctx.createOscillator(), gain = ctx.createGain();
    osc.connect(gain); gain.connect(ctx.destination);
    osc.frequency.value = 880; osc.type = 'sine';
    gain.gain.setValueAtTime(0, ctx.currentTime);
    gain.gain.linearRampToValueAtTime(0.08, ctx.currentTime + 0.02);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
    osc.start(ctx.currentTime); osc.stop(ctx.currentTime + 0.4);
    ignorarAte = performance.now() + 450;
  } catch (_) {}
}

function resetDisplay() {
  temLeitura = false; ultimas.length = 0; saltos = 0;
  noteName.textContent = '–';
  noteName.style.color = '';
  noteOctave.textContent = '';
  freqDisplay.textContent = '– Hz';
  targetLine.innerHTML = textoAlvoParado();
  setPill(null); setDica(null, false); setInTune(false); setCor('#e63946');
  anguloAlvo = 0;
  tunerDisplay.classList.remove('holding-state');
  atualizarCards(-1, false, true);
}

// ─── Loop ────────────────────────────────────────────────────────────────────
function loop() {
  if (!analyser || !audioCtx) return;
  rafId = requestAnimationFrame(loop);
  if (audioCtx.state === 'suspended') { audioCtx.resume().catch(() => {}); return; }

  analyser.getFloatTimeDomainData(buf);
  const agora = performance.now();
  const { f, clareza, rms } = detectar(audioCtx.sampleRate);
  levelBar.style.transform = `scaleX(${Math.min(1, Math.sqrt(rms / 0.08)).toFixed(3)})`;

  let ok = f > 50 && f < 1400 && agora > ignorarAte;
  if (ok) {
    const m = 69 + 12 * Math.log2(f / 440);
    // Clareza média só vale se confirma a leitura atual (nota decaindo).
    if (clareza < 0.8 && !(temLeitura && Math.abs(m - suave) < 0.3)) ok = false;
    else registrar(m, agora);
  }

  if (temLeitura && agora - ultimaValida < 120) {
    tunerDisplay.classList.remove('holding-state');
    const m = suave;
    const alvo = escolherAlvo(m);
    alvoAtual = alvo;
    const ref = alvo ? alvo.midi : Math.round(m);
    const c = (m - ref) * 100;
    const abs = Math.abs(c);
    const arred = Math.round(m);

    const t = afinacao();
    const escrita = alvo && ((arred - alvo.midi) % 12 === 0) ? letra(t.strings[alvo.idx]) : NOTE_NAMES[((arred % 12) + 12) % 12];
    noteName.textContent = escrita;
    noteOctave.textContent = String(Math.floor(arred / 12) - 1);
    freqDisplay.textContent = `${midiToFreq(m).toFixed(1)} Hz`;
    targetLine.innerHTML = alvo
      ? `<strong>${nomeCorda(alvo.idx)}</strong> · ${SOLFEJO[letra(t.strings[alvo.idx])]}${alvo.oitava && travada < 0 ? ' (corda da oitava)' : ''}${alvo.tambem !== undefined && travada < 0 ? `, serve também para a corda fina do ${nomeCorda(alvo.tambem)}` : ''}`
      : 'Fora das cordas desta afinação. Toque no card da corda para travar nela.';

    // Afinado com histerese: entra com ≤4¢ por 250 ms, sai acima de 7¢.
    if (alvo && (afinado ? abs <= 7 : abs <= 4)) {
      if (!afinadoDesde) afinadoDesde = agora;
      if (!afinado && agora - afinadoDesde > 250) {
        setInTune(true);
        if (!feitas.has(alvo.idx)) { feitas.add(alvo.idx); playTuneSound(audioCtx); }
      }
    } else {
      afinadoDesde = 0;
      setInTune(false);
    }

    anguloAlvo = Math.max(-50, Math.min(50, c)) * 1.8;
    const cor = afinado ? '#22c55e' : corPara(abs);
    setCor(cor);
    noteName.style.color = afinado || abs <= 5 ? '#22c55e' : abs <= 20 ? '#facc15' : '#e63946';
    setPill(alvo || abs < 50 ? c : null);
    setDica(alvo ? c : null, afinado);
    atualizarCards(alvo ? alvo.idx : -1, afinado);
  } else if (temLeitura && agora - ultimaValida < 1500) {
    // Corda soltou: segura a última leitura (sem a agulha voltar ao centro e
    // fingir que está afinado).
    tunerDisplay.classList.add('holding-state');
  } else if (temLeitura) {
    alvoAtual = null;
    afinadoDesde = 0;
    resetDisplay();
  }
  desenharAgulha();
}

// ─── Microfone ───────────────────────────────────────────────────────────────
async function manterTela() {
  try { wakeLock = await (navigator as any).wakeLock?.request('screen'); } catch (_) { wakeLock = null; }
}
document.addEventListener('visibilitychange', () => {
  if (!document.hidden && isListening && !wakeLock) manterTela();
});

micBtn.addEventListener('click', async () => {
  if (isListening) { stopListening(); return; }
  (window as any).gtag?.('event', 'tool_use', { ferramenta: 'afinador', acao: 'microfone', instrumento: instrument });
  try {
    micStatus.textContent = 'Pedindo acesso ao microfone…';
    try { if ((navigator as any).audioSession) (navigator as any).audioSession.type = 'play-and-record'; } catch (_) {}
    micStream = await navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false, channelCount: 1 },
    });
    const Ctx = (window.AudioContext || (window as any).webkitAudioContext) as typeof AudioContext;
    audioCtx = new Ctx();
    if (audioCtx.state === 'suspended') await audioCtx.resume();
    analyser = audioCtx.createAnalyser();
    analyser.fftSize = audioCtx.sampleRate > 50000 ? 8192 : 4096;
    analyser.smoothingTimeConstant = 0;
    audioCtx.createMediaStreamSource(micStream).connect(analyser);
    buf = new Float32Array(analyser.fftSize);
    dec = new Float32Array(analyser.fftSize);
    pisoRuido = 0.002;

    isListening = true;
    micBtn.classList.add('active');
    micLabel.textContent = 'Parar';
    micStatus.textContent = 'Ouvindo. Toque uma corda de cada vez, perto do microfone.';
    resetDisplay();
    manterTela();
    loop();
  } catch (err: any) {
    micStatus.textContent = err?.name === 'NotAllowedError'
      ? 'Acesso ao microfone negado. Libere o microfone para este site nas configurações do navegador e toque de novo.'
      : err?.name === 'NotFoundError'
      ? 'Nenhum microfone encontrado neste aparelho.'
      : `Não deu para abrir o microfone: ${err?.message ?? 'erro desconhecido'}`;
  }
});

function stopListening() {
  if (rafId) cancelAnimationFrame(rafId);
  micStream?.getTracks().forEach((t) => t.stop());
  audioCtx?.close();
  wakeLock?.release?.().catch(() => {}); wakeLock = null;
  audioCtx = null; analyser = null; micStream = null;
  isListening = false;
  micBtn.classList.remove('active');
  micLabel.textContent = 'Ativar microfone';
  micStatus.textContent = '';
  levelBar.style.transform = 'scaleX(0)';
  anguloAtual = 0;
  needle.setAttribute('transform', 'rotate(0 150 140)');
  resetDisplay();
}

renderTunings();
renderStrings();
resetDisplay();
</script>
