    opacity: 1;
    transform: translateY(0);
  }

  /* ── Needle SVG ──────────────────────────────────────────── */
  .needle-wrap {
    display: flex;
    justify-content: center;
    margin: 0.25rem 0 0.5rem;
  }

  .needle-svg {
    width: 100%;
    height: auto;
  }

  /* ── Frequência ──────────────────────────────────────────── */
  .freq-row {
    text-align: center;
  }

  .freq-display {
    font-size: 0.75rem;
    font-family: ui-monospace, monospace;
    color: var(--color-subtle);
  }

  /* ── Cordas ──────────────────────────────────────────────── */
  .strings-grid {
    display: grid;
    grid-template-columns: repeat(var(--cordas, 6), 1fr);
