    min-width: 60px;
    text-align: center;
  }

  .cents-pill--idle   { background: rgba(255,255,255,0.06); color: var(--color-subtle); }
  .cents-pill--green  { background: rgba(34,197,94,0.15);  color: #4ade80; }
  .cents-pill--yellow { background: rgba(250,204,21,0.15); color: #fde047; }
  .cents-pill--red    { background: rgba(230,57,70,0.15);  color: #f87171; }

  /* In-tune badge */
  .in-tune-badge {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: #22c55e;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.35s, transform 0.35s;
  }

