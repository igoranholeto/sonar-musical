  .string-card:active { transform: scale(0.96); }

  .string-card.active  { border-color: var(--color-brand); background: rgba(230,57,70,0.1); }
  .string-card.in-tune { border-color: #22c55e;            background: rgba(34,197,94,0.12); }
  .string-card.locked  { border-color: var(--color-brand); box-shadow: inset 0 0 0 1px var(--color-brand); }
  .string-card.done::after {
    content: '✓'; position: absolute; top: 3px; right: 6px;
    font-size: 0.7rem; font-weight: 800; color: #22c55e;
  }

  .string-num  { display: block; font-size: 0.62rem; color: var(--color-subtle); margin-bottom: 2px; white-space: nowrap; }
  .string-note { display: block; font-size: 0.95rem; font-weight: 800; }
  .string-full { display: block; font-size: 0.62rem; color: var(--color-subtle); margin-top: 1px; }

  .strings-hint {
    font-size: 0.75rem; color: var(--color-subtle); text-align: center;
    margin: -0.75rem 0 2.5rem; min-height: 1.2em;
  }

  /* Corda/par alvo, acima da nota */
  .target-line {
    font-size: 0.78rem; font-weight: 600; color: var(--color-muted);
    margin: 0 0 0.35rem; min-height: 1.2em; text-align: center;
  }
  .target-line strong { color: var(--color-foreground); }

  /* Nível do microfone: mostra que ele está ouvindo, mesmo sem nota */
  .freq-row { display: flex; align-items: center; justify-content: center; gap: 0.6rem; }
  .level { width: 64px; height: 4px; border-radius: 2px; background: var(--color-elevated, rgba(255,255,255,0.08)); overflow: hidden; }
  .level__bar { display: block; height: 100%; width: 100%; background: var(--color-subtle); transform-origin: left; transform: scaleX(0); transition: transform 0.08s linear; }

  /* ── Microfone ───────────────────────────────────────────── */
  .mic-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .mic-btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 2.25rem;
    border-radius: 999px;
    border: none;
    background: var(--color-brand-fill);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: background 0.18s, box-shadow 0.18s, transform 0.15s;
    box-shadow: 0 2px 12px rgba(230,57,70,0.35);
  }

  .mic-btn:hover {
    background: #d02f3c;
    box-shadow: 0 4px 18px rgba(230,57,70,0.45);
    transform: translateY(-1px);
  }

  .mic-btn.active {
    background: #b5202d;
    animation: pulse-mic 2s infinite;
  }

  @keyframes pulse-mic {
    0%,100% { box-shadow: 0 0 0 0 rgba(230,57,70,0.4); }
    50%      { box-shadow: 0 0 0 12px rgba(230,57,70,0); }
