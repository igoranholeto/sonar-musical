  .mic-status {
    font-size: 0.78rem;
    color: var(--color-subtle);
    margin: 0;
    min-height: 1.1em;
    text-align: center;
  }

  /* ── Direction hint ─────────────────────────────────────── */
  .direction-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.7rem 1.25rem;
    border-radius: 10px;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    margin: 0 0 0.75rem;
    transition: opacity 0.2s, transform 0.2s;
