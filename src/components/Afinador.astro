  /* ── Nota ────────────────────────────────────────────────── */
  .note-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .note-row {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 2px;
    line-height: 1;
  }

  .note-name {
    font-size: 5rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    transition: color 0.2s;
    line-height: 1;
