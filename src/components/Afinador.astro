    { label: 'Cebolão em Ré',  strings: ['A2','D3','F#3','A3','D4'], oitavas: OIT_VIOLA },
    { label: 'Cebolão em Mi',  strings: ['B2','E3','G#3','B3','E4'], oitavas: OIT_VIOLA },
    { label: 'Rio Abaixo',     strings: ['G2','D3','G3','B3','D4'], oitavas: OIT_VIOLA },
    { label: 'Natural',        strings: ['A2','D3','G3','B3','E4'], oitavas: OIT_VIOLA },
  ],
  bandolim: [
    { label: 'Sol Ré Lá Mi (GDAE)', strings: ['G3','D4','A4','E5'] },
  ],
